# Le .env du site de démonstration sur un poste (lot DEMO-COPIE, voir le
# README, « Le site de démonstration »). Copiez ce fichier en
# .env.demonstration, remplissez les valeurs marquées, puis lancez le site
# par : php artisan --env=demonstration serve --host=localhost --port=8001
# Le site réel reste servi sur 127.0.0.1:8000, avec son .env : les témoins
# des deux sites ne se mêlent pas. Aucune valeur ni clé du site réel ne se
# recopie ici : le site de démonstration refuse de démarrer avec elles.

APP_NAME="Piliqi Démonstration"
# Le nom du fichier : php artisan --env=demonstration lit .env.demonstration.
APP_ENV=demonstration
# Une clé propre à ce site (php artisan --env=demonstration key:generate),
# jamais celle du site réel.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

PILIQI_SITE=demonstration
PILIQI_VERSION=

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=debug

# La base par défaut est la base sentinelle vide : une requête qui
# n'ouvrirait pas sa copie ne lit rien. Chaque copie s'ouvre par le rôle
# des pages (demo_app).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=demo_aucune_copie
DB_USERNAME=demo_app
# Le mot de passe du rôle demo_app (choisi à sa création, voir le README).
DB_PASSWORD=

# Le registre des copies, lu par les pages (demo_app) et écrit par les
# commandes et le travailleur de la file demonstration-admin (demo_admin,
# qui crée, copie et supprime les bases).
DB_REGISTRE_HOST=127.0.0.1
DB_REGISTRE_PORT=5432
DB_REGISTRE_DATABASE=piliqi_demo_registre
DB_REGISTRE_USERNAME=demo_app
# Le mot de passe de demo_app.
DB_REGISTRE_PASSWORD=
DB_DEMO_ADMIN_USERNAME=demo_admin
# Le mot de passe de demo_admin (choisi à sa création, voir le README).
DB_DEMO_ADMIN_PASSWORD=

# Hors d'une copie, le cache du registre ; dans une copie, sa base.
CACHE_STORE=registre
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=demonstration

# Les e-mails ne partent jamais : chaque copie les garde pour sa page
# « E-mails qui seraient partis ».
MAIL_MAILER=demonstration

# Seulement les fournisseurs factices (l'antivirus : factice sur un poste,
# ClamAV, local, en production, où le site refuse de démarrer avec le
# factice).
SIRENE_PILOTE=faux
RNE_PILOTE=faux
RECOMMANDE_PILOTE=faux
ORDRE_PILOTE=faux
PDP_PILOTE=faux
VIES_PILOTE=faux
ANTIVIRUS_PILOTE=factice

# L'origine exacte du site réel, seule page d'où le billet du bouton
# « Ouvrir ma démonstration » est accepté.
DEMONSTRATION_ORIGINE_DU_SITE_REEL=http://127.0.0.1:8000
DEMONSTRATION_NOM_DU_SITE=piliqi-demonstration
# Les clés publiques des messages du site réel, en JSON
# {"identifiant": "clé publique en base64"}, que php artisan
# demonstration:generer-cle affiche sur le site réel.
DEMONSTRATION_MESSAGES_CLES_PUBLIQUES=
# La clé privée de l'état publié, tirée par php artisan --env=demonstration
# demonstration:generer-cle --etat (sa clé publique va dans le .env du
# site réel, DEMONSTRATION_ETAT_CLE_PUBLIQUE).
DEMONSTRATION_ETAT_CLE_PRIVEE=
DEMONSTRATION_COPIES_MAX=200
DEMONSTRATION_COPIES_EN_MEME_TEMPS=2
DEMONSTRATION_PART_DES_VALIDEES=50
DEMONSTRATION_STRATEGIE_DE_COPIE=FILE_COPY
# La place d'une copie : au-delà de ce multiple de la taille de son modèle,
# elle passe en lecture seule (demonstration:mesurer-les-copies) ; sous ce
# pourcentage de place libre sur le disque des copies, plus aucune copie
# neuve ne se crée.
DEMONSTRATION_FACTEUR_DE_PLACE=3
DEMONSTRATION_PLACE_LIBRE_MINIMALE=20

# La caisse d'entraînement des copies signe avec sa propre clé, épinglée
# dans resources/caisse-securisee/cles-demonstration
# (php artisan --env=demonstration caisse:generer-cle).
CAISSE_SECURISEE_CLE_PRIVEE=
# Le journal d'audit des copies se chaîne avec sa propre clé, dont
# l'empreinte s'épingle par php artisan --env=demonstration
# journal-audit:epingler-la-cle.
JOURNAL_AUDIT_CLE=
JOURNAL_AUDIT_CLE_ID=
