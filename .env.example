APP_NAME="Piliqi Editeur"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Développement : SQLite (database/database.sqlite). Production :
# PostgreSQL 17 ou 18, base en UTF8 et collation C.UTF-8 ; le mot de passe
# ne va jamais dans le dépôt (voir README et CLAUDE.md, étape 15).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=piliqi
# DB_USERNAME=piliqi
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mails (devis, factures, avoirs, relances : voir EnvoyerDocumentJob).
# En développement, "log" écrit chaque e-mail dans storage/logs au lieu de
# l'envoyer. Les e-mails partent en file d'attente : en production, un
# worker doit tourner (php artisan queue:work).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Adresse d'envoi de l'éditeur, sur un domaine dont les enregistrements SPF,
# DKIM et DMARC autorisent le serveur SMTP ci-dessous. Chaque e-mail porte
# le nom du magasin, et les réponses du client vont à l'adresse e-mail du
# magasin (voir DocumentMail).
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production : serveur SMTP du prestataire d'envoi retenu par l'éditeur.
# MAIL_SCHEME vaut "smtps" sur le port 465 (TLS direct), "smtp" sur le
# port 587 (STARTTLS). Le mot de passe ne va jamais dans le dépôt : il
# n'existe que dans le .env du serveur. MAIL_EHLO_DOMAIN est le domaine
# annoncé au serveur SMTP.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.prestataire.example
# MAIL_PORT=465
# MAIL_USERNAME=identifiant-smtp
# MAIL_PASSWORD=mot-de-passe-smtp
# MAIL_EHLO_DOMAIN=piliqi.example
# MAIL_FROM_ADDRESS="factures@piliqi.example"
# MAIL_FROM_NAME="Piliqi"

# Caisse sécurisée (art. 286 du CGI) : clé privée de signature fiscale de
# l'éditeur, PEM encodé en base64 sur une seule ligne, telle que l'affiche
# php artisan caisse:generer-cle, et sa phrase secrète si elle est
# chiffrée. Elle ne va jamais dans le dépôt : elle n'existe que dans le
# .env du serveur et dans le coffre de l'éditeur. Sa clé publique doit être
# épinglée dans resources/caisse-securisee/cles. Sans elle, rien n'est
# signé (voir php artisan caisse:diagnostiquer).
CAISSE_SECURISEE_CLE_PRIVEE=
CAISSE_SECURISEE_PHRASE_SECRETE=

# Durées de conservation (voir config/conservation.php) : l'adresse IP et
# le navigateur des événements techniques s'effacent après ce nombre de
# mois (12 sans cette ligne).
# CONSERVATION_TRACES_EN_MOIS=12

# VIES, le service de la Commission européenne qui vérifie les n° de TVA
# des clients de l'Union (voir ClientVies). Sans cette ligne, l'API
# officielle : https://ec.europa.eu/taxation_customs/vies/rest-api
# VIES_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
