{
    // Tests de mutation (décision de l'éditeur du 01/11/2026) : Infection
    // modifie le code de petites façons et vérifie qu'un test échoue à
    // chaque fois. Seules les parties sensibles (les calculs, les droits et
    // l'isolation, voir PARTIES_SENSIBLES dans tests/Qualite/qualite.php)
    // se testent. À chaque envoi, la CI lance Infection avec cette
    // configuration sur les seuls fichiers sensibles changés, chacun muté
    // en entier, dont les chemins viennent de
    // php tests/Qualite/qualite.php sensibles-changes <base>, après « -- » ;
    // le passage complet de ces parties se lance avec la configuration que
    // tire de celle-ci php tests/Qualite/qualite.php configuration-sensibles
    // <fichier>, qui exclut tout autre fichier. Leur score minimal est dans
    // tests/Qualite/seuils.json et se contrôle par
    // php tests/Qualite/qualite.php mutation.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["app"]
    },
    "timeout": 120,
    "tmpDir": "storage/framework/cache/infection",
    "logs": {
        "text": "storage/qualite/infection.log",
        "json": "storage/qualite/infection.json"
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Unit,Feature",
    "mutators": {
        "@default": true
    }
}
