{
    // Tests de mutation (décision de l'éditeur du 01/11/2026) : Infection
    // modifie le code de petites façons et vérifie qu'un test échoue à
    // chaque fois. Les parties sensibles (tests/Qualite/parties.php) se
    // choisissent par --filter (php tests/Qualite/qualite.php sensibles) ;
    // leur score minimal est dans tests/Qualite/seuils.json et se contrôle
    // par php tests/Qualite/qualite.php mutation.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["app"]
    },
    "timeout": 120,
    "tmpDir": "storage/framework/cache/infection",
    "logs": {
        "text": "storage/qualite/infection.log",
        "json": "storage/qualite/infection.json"
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Unit,Feature",
    "mutators": {
        "@default": true
    }
}
