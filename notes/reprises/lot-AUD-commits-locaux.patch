+            .'SELECT sum(l.quantite) INTO plafond FROM lignes_avoir_fournisseur l WHERE l.magasin_id = NEW.magasin_id AND l.avoir_fournisseur_id = NEW.source_id AND l.produit_id = NEW.produit_id; '
