+
+        $autreMagasin = Magasin::factory()->create();
+        app(TenantContext::class)->set($autreMagasin);
+        MandatPdp::factory()->create(['magasin_id' => $autreMagasin->id]);
+        $ailleurs = $this->emettreFacturePour(Client::factory()->professionnel()->create());
