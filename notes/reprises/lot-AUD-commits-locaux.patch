+            ."IF plafond IS NULL THEN RAISE EXCEPTION '%', TG_ARGV[0]; END IF; "
+            ."SELECT sens * (coalesce(sum({$variation}), 0) + ".self::variation('NEW').') INTO net FROM mouvements_stock m '
