         $connexion->unprepared('CREATE OR REPLACE FUNCTION refus_ticket_z_non_signe() RETURNS trigger LANGUAGE plpgsql '.DeclencheursDeProtection::CHEMIN_DE_RECHERCHE.' AS $$ BEGIN '
