+        $instantane = [];
+
+        foreach ($tables as $table) {
+            $instantane[$table] = array_map(
+                static fn (object $ligne): string => (string) $ligne->ligne,
+                DB::select("select to_jsonb(t)::text as ligne from {$table} t order by 1"),
