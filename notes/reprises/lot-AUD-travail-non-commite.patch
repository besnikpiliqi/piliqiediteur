+            'magasin_id' => $magasin->id,
+            'numero' => $numero,
+            'date_cloture' => $journee,
+            'recapitulatif' => json_encode(RecapitulatifDeCloture::vide(), JSON_THROW_ON_ERROR),
+            'cloturee_a' => $clotureeA->utc()->format('Y-m-d H:i:s'),
