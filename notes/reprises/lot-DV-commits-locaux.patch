+<?php
+
+namespace App\Domain\Facturation\Models;
+
+use App\Domain\Calendrier\Casts\Instant;
+use App\Domain\Facturation\Enums\StatutDevis;
+use App\Domain\Tenancy\Concerns\BelongsToMagasin;
+use App\Domain\Tenancy\Concerns\FigeLeNomDeSesAuteurs;
+use App\Domain\Tenancy\Support\ValeurRequise;
+use Carbon\CarbonImmutable;
+use Carbon\CarbonInterface;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\HasOne;
+use Illuminate\Support\Str;
+
+/**
+ * Le lien secret par lequel le client répond à un devis envoyé par
+ * e-mail, sans compte (décision de l'éditeur du 02/11/2026) : un par
+ * envoi, créé avec lui (voir EnvoyerDocumentAction). Son jeton, d'au moins
+ * 256 bits, est tiré par la tâche d'envoi juste avant le départ de
+ * l'e-mail, qui seul le porte (voir EnvoyerDocumentJob::jetonDuLien()) :
+ * la base n'en garde que l'empreinte SHA-256, aucun journal ne l'écrit.
+ *
+ * Il vaut tant que son devis, envoyé, attend sa réponse dans sa validité,
+ * dans la version que cet e-mail a portée (voir estValable()) : il cesse
+ * aussitôt de valoir à la réponse du client, à l'acceptation ou au refus
+ * constaté par le magasin, à l'expiration, à la transformation en facture,
+ * à une modification du devis, à un nouvel envoi, qui donne un nouveau
+ * lien, et quand le magasin le retire (voir RetirerLeLienDuDevisAction).
+ *
+ * Seule lecture hors du magasin actif : celle du lien que désigne le
+ * jeton de l'adresse, avant qu'aucun magasin ne soit ouvert (voir
+ * parSonJeton()).
+ *
+ * @property int $devis_id
+ * @property int $envoi_document_id
+ * @property CarbonImmutable|null $retire_le
+ * @property CarbonInterface $created_at
+ * @property-read Devis $devis
+ * @property-read EnvoiDocument $envoi
+ * @property-read ReponseDuDevis|null $reponse
+ */
+class LienDuDevis extends Model
+{
+    use BelongsToMagasin, FigeLeNomDeSesAuteurs;
+
+    /**
+     * La longueur du jeton : 64 caractères alphanumériques, environ 381
+     * bits.
+     */
+    public const LONGUEUR_DU_JETON = 64;
+
+    /**
+     * La seule réponse d'une adresse au jeton inconnu, expiré ou déjà
+     * servi : elle ne dit rien d'autre.
+     */
+    public const PLUS_VALABLE = 'Ce lien n\'est plus valable.';
+
+    protected $table = 'liens_des_devis';
+
+    protected $fillable = [];
+
+    protected $hidden = ['jeton_hache'];
+
+    protected $casts = [
+        'retire_le' => Instant::class,
+    ];
+
+    protected static function colonnesAuNomFige(): array
+    {
+        return ['retire_par' => 'retire_par_nom'];
+    }
+
+    /**
+     * Un nouveau jeton, à mettre dans l'e-mail : seule son empreinte se
+     * garde (voir empreinte()).
+     */
+    public static function nouveauJeton(): string
+    {
+        return Str::random(self::LONGUEUR_DU_JETON);
+    }
+
+    /**
+     * L'empreinte d'un jeton, telle qu'elle se garde et se cherche.
+     */
+    public static function empreinte(string $jeton): string
+    {
+        return hash('sha256', $jeton);
+    }
+
+    /**
+     * Le lien que désigne ce jeton, hors de tout magasin (la page du lien
+     * s'ouvre avant qu'aucun ne le soit), valable ou non ; null pour un
+     * jeton inconnu. Seulement les colonnes qui disent si le lien vaut et
+     * de quel devis il s'agit.
+     */
+    public static function parSonJeton(string $jeton): ?self
+    {
+        return self::withoutGlobalScopes()
+            ->where('jeton_hache', self::empreinte($jeton))
+            ->first(['id', 'magasin_id', 'devis_id', 'envoi_document_id', 'retire_le', 'created_at']);
+    }
+
+    /**
+     * @return BelongsTo<Devis, $this>
+     */
+    public function devis(): BelongsTo
+    {
+        return $this->belongsTo(Devis::class);
+    }
+
+    /**
+     * @return BelongsTo<EnvoiDocument, $this>
+     */
+    public function envoi(): BelongsTo
+    {
+        return $this->belongsTo(EnvoiDocument::class, 'envoi_document_id');
+    }
+
+    /**
+     * @return HasOne<ReponseDuDevis, $this>
+     */
+    public function reponse(): HasOne
+    {
+        return $this->hasOne(ReponseDuDevis::class);
+    }
+
+    /**
+     * Le lien vaut encore, d'après son devis tel que l'appelant l'a lu
+     * (sous verrou pour une réponse, voir RepondreAuDevisEnLigneAction) :
+     * pas retiré, sans réponse, le dernier lien de son devis, qui est
+     * envoyé, dans sa validité, et n'a pas été renvoyé dans une nouvelle
+     * version depuis cet envoi ; son magasin écrit encore à ses clients.
+     */
+    public function estValable(Devis $devis): bool
+    {
+        return $this->retire_le === null
+            && $devis->getKey() === $this->devis_id
+            && $devis->statut === StatutDevis::Envoye
+            && ! $devis->validiteDepassee()
+            && ValeurRequise::de($devis->date_emission, 'la date d\'envoi du devis')->lte($this->created_at)
+            && $devis->magasin->peutEcrireAuxClients()
+            && $this->reponse()->doesntExist()
+            && self::query()->where('devis_id', $this->devis_id)->where('id', '>', $this->getKey())->doesntExist();
+    }
+}
diff --git a/app/Domain/Facturation/Models/ReponseDuDevis.php b/app/Domain/Facturation/Models/ReponseDuDevis.php
new file mode 100644
index 0000000..a73071c
--- /dev/null
+++ b/app/Domain/Facturation/Models/ReponseDuDevis.php
@@ -0,0 +1,66 @@
+<?php
+
+namespace App\Domain\Facturation\Models;
+
+use App\Domain\Calendrier\Casts\Instant;
+use App\Domain\Facturation\Enums\ReponseAuDevis;
+use App\Domain\Tenancy\Concerns\BelongsToMagasin;
+use Carbon\CarbonImmutable;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+/**
+ * La réponse du client à un devis par son lien secret (voir
+ * RepondreAuDevisEnLigneAction), une seule par lien : l'acceptation, avec
+ * le nom qu'il a tapé en cochant « Bon pour accord » (signature
+ * électronique simple), ou le refus, avec son motif facultatif ; l'instant
+ * (UTC, affiché à l'heure du magasin) et l'empreinte de la version du
+ * devis à laquelle il a répondu (voir Devis::empreinteDeSaVersion()). En
+ * ajout seul : la base refuse de la modifier ou de l'effacer. L'adresse
+ * IP et le navigateur du client sont ailleurs, dans les traces techniques
+ * du journal d'audit et du journal des événements, effacées après un an.
+ *
+ * @property int $devis_id
+ * @property int $lien_du_devis_id
+ * @property ReponseAuDevis $reponse
+ * @property string|null $signataire
+ * @property string|null $motif
+ * @property string $empreinte_du_devis
+ * @property CarbonImmutable $created_at
+ */
+class ReponseDuDevis extends Model
+{
+    use BelongsToMagasin;
+
+    /**
+     * L'instant de la réponse s'écrit par son action, avec son fuseau
+     * (voir Instant) : jamais par l'horodatage automatique, qui l'écrirait
+     * en chaîne.
+     */
+    public $timestamps = false;
+
+    protected $table = 'reponses_des_devis';
+
+    protected $fillable = [];
+
+    protected $casts = [
+        'reponse' => ReponseAuDevis::class,
+        'created_at' => Instant::class,
+    ];
+
+    /**
+     * @return BelongsTo<Devis, $this>
+     */
+    public function devis(): BelongsTo
+    {
+        return $this->belongsTo(Devis::class);
+    }
+
+    /**
+     * @return BelongsTo<LienDuDevis, $this>
+     */
+    public function lien(): BelongsTo
+    {
+        return $this->belongsTo(LienDuDevis::class, 'lien_du_devis_id');
+    }
+}
diff --git a/app/Domain/Facturation/Notifications/ReponseDuClientAuDevis.php b/app/Domain/Facturation/Notifications/ReponseDuClientAuDevis.php
new file mode 100644
index 0000000..e22d1bd
--- /dev/null
+++ b/app/Domain/Facturation/Notifications/ReponseDuClientAuDevis.php
@@ -0,0 +1,124 @@
+<?php
+
+namespace App\Domain\Facturation\Notifications;
+
+use App\Domain\Facturation\Enums\ReponseAuDevis;
+use App\Domain\Facturation\Models\Devis;
+use App\Domain\Facturation\Models\ReponseDuDevis;
+use App\Domain\Tenancy\Models\Magasin;
+use App\Domain\Tenancy\Notifications\NotificationDuMagasin;
+use App\Domain\Tenancy\Support\Reglage;
+use App\Filament\App\Resources\DevisResource;
+use Filament\Notifications\Actions\Action;
+use Filament\Notifications\Notification as NotificationFilament;
+use Illuminate\Notifications\Messages\MailMessage;
+
+/**
+ * Le client a répondu à un devis par son lien secret (voir
+ * RepondreAuDevisEnLigneAction) : la personne qui a demandé l'envoi et le
+ * propriétaire de la société le lisent dans la cloche et par e-mail (à
+ * l'adresse de leur compte, quand il en a une). L'avis d'une acceptation
+ * dit combien de produits du devis n'ont plus assez de stock, et
+ * lesquels : le devis ne réserve rien, l'émission de la facture contrôle
+ * le stock. Il mène à la fiche du devis, où se fait la transformation en
+ * facture.
+ */
+final class ReponseDuClientAuDevis extends NotificationDuMagasin
+{
+    /**
+     * @param  list<array{produit: string, demande: int, disponible: int}>  $stocksInsuffisants
+     */
+    public function __construct(
+        Magasin $magasin,
+        public readonly Devis $devis,
+        public readonly ReponseDuDevis $reponse,
+        public readonly array $stocksInsuffisants,
+    ) {
+        parent::__construct($magasin);
+    }
+
+    /**
+     * @return list<string>
+     */
+    public function via(object $notifiable): array
+    {
+        return ['database', 'mail'];
+    }
+
+    public function toMail(object $notifiable): MailMessage
+    {
+        $message = (new MailMessage)
+            ->subject("{$this->titre()} · {$this->magasin->nom}")
+            ->line($this->texte());
+
+        foreach ($this->lignesDuStock() as $ligne) {
+            $message->line($ligne);
+        }
+
+        return $message
+            ->action('Voir le devis', $this->adresseDuDevis())
+            ->line('Ce message vous est envoyé pour le magasin '.$this->magasin->nom.' sur '.Reglage::texte('app.name').'.');
+    }
+
+    protected function contenu(): NotificationFilament
+    {
+        $notification = NotificationFilament::make()
+            ->title($this->titre())
+            ->body(implode(' ', [$this->texte(), ...$this->lignesDuStock()]))
+            ->icon($this->reponse->reponse === ReponseAuDevis::Acceptation ? 'heroicon-o-check-circle' : 'heroicon-o-x-circle')
+            ->actions([
+                Action::make('voir')
+                    ->label('Voir le devis')
+                    ->url($this->adresseDuDevis())
+                    ->markAsRead(),
+            ]);
+
+        return match (true) {
+            $this->reponse->reponse === ReponseAuDevis::Refus => $notification->danger(),
+            $this->stocksInsuffisants !== [] => $notification->warning(),
+            default => $notification->success(),
+        };
+    }
+
+    private function titre(): string
+    {
+        return $this->reponse->reponse === ReponseAuDevis::Acceptation
+            ? "Devis {$this->devis->numero} accepté en ligne"
+            : "Devis {$this->devis->numero} refusé en ligne";
+    }
+
+    private function texte(): string
+    {
+        $quand = $this->magasin->calendrier()->afficher($this->reponse->created_at, 'd/m/Y à H:i');
+
+        if ($this->reponse->reponse === ReponseAuDevis::Acceptation) {
+            return "Le client a accepté le devis {$this->devis->numero} le {$quand}, signé « {$this->reponse->signataire} » avec la mention « Bon pour accord ». Un compte autorisé à vendre peut maintenant le transformer en facture.";
+        }
+
+        return "Le client a refusé le devis {$this->devis->numero} le {$quand}".($this->reponse->motif === null ? '.' : ", avec ce motif : « {$this->reponse->motif} ».");
+    }
+
+    /**
+     * @return list<string>
+     */
+    private function lignesDuStock(): array
+    {
+        if ($this->stocksInsuffisants === []) {
+            return [];
+        }
+
+        $nombre = count($this->stocksInsuffisants);
+        $lignes = [($nombre === 1 ? '1 produit n\'a' : "{$nombre} produits n'ont").' plus assez de stock :'];
+
+        foreach ($this->stocksInsuffisants as $manque) {
+            $lignes[] = "« {$manque['produit']} » : {$manque['demande']} demandé".($manque['demande'] > 1 ? 's' : '').", {$manque['disponible']} en stock.";
+        }
+
+        return $lignes;
+    }
+
+    private function adresseDuDevis(): string
+    {
+        return DevisResource::getUrl('view', ['record' => $this->devis], panel: 'app', tenant: $this->magasin);
+    }
+}
