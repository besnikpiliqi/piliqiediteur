index 0000000..38a7813
--- /dev/null
+++ b/app/Domain/Cabinets/Services/EnvoiDesLiensDesExpertsComptables.php
@@ -0,0 +1,101 @@
+<?php
+
+namespace App\Domain\Cabinets\Services;
+
+use App\Domain\Authorization\PermissionRegistry;
+use App\Domain\Cabinets\Mail\LienDuMotDePasseDeLExpertComptableMail;
+use App\Domain\Cabinets\Models\CompteExpertComptable;
+use App\Domain\Calendrier\Calendrier;
+use App\Domain\Tenancy\Enums\RoleSociete;
+use App\Domain\Tenancy\Enums\StatutSociete;
+use App\Domain\Tenancy\Models\Societe;
+use App\Domain\Tenancy\Notifications\AvisDeLEquipe;
+use App\Domain\Tenancy\Services\TenantContext;
+use App\Domain\Tenancy\Support\ValeurRequise;
+use App\Filament\Societe\Pages\CabinetComptable;
+use App\Integrations\Courriel\CourrielNonParti;
+use App\Integrations\Courriel\EnvoiImmediat;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Mail;
+use SensitiveParameter;
+
+/**
+ * L'envoi du lien de 7 jours où un expert-comptable de la société choisit
+ * son mot de passe, après la transaction qui l'a tiré (déclaration, ajout
+ * d'une personne, correction de son adresse, accès redonné par un lien) :
+ * sans file d'attente, le jeton en mémoire seulement, jamais écrit dans une
+ * file ni en base (seule son empreinte l'est, voir CompteExpertComptable).
+ *
+ * Tout est relu au moment de l'envoi : le lien ne part que si le compte est
+ * actif et de ce rôle, son lien encore celui-ci et pas expiré, sa
+ * déclaration en attente, sa société ni close ni révoquée et l'auteur
+ * encore son propriétaire ; sinon il ne part pas, et le propriétaire
+ * actuel en est prévenu (« E-mail non envoyé »). Une messagerie en panne
+ * efface le lien, prévient le propriétaire, qui en envoie un autre depuis
+ * la fiche, et le dit à l'écran (voir CourrielNonParti).
+ */
+class EnvoiDesLiensDesExpertsComptables
+{
+    /**
+     * @throws CourrielNonParti
+     */
+    public function envoyer(int $compteId, #[SensitiveParameter] string $jeton, int $auteurId, bool $accesRedonne): void
+    {
+        $attachement = CompteExpertComptable::parSonJeton($jeton);
+        $compte = $attachement === null ? null : User::query()->where('societe_id', $attachement->societe_id)->whereKey($compteId)->first();
+        $societe = $compte === null ? null : Societe::query()->find($compte->societe_id);
+
+        if ($attachement === null || $compte === null || $societe === null || $attachement->user_id !== $compteId) {
+            return;
+        }
+
+        $auteur = User::query()->where('societe_id', $societe->getKey())->whereKey($auteurId)->first();
+        $declaration = app(TenantContext::class)->runAsSociete($societe, fn () => app(ExpertsComptablesDeclares::class)->declarationDe($compte));
+
+        if (! $compte->estActif() || $compte->role_societe !== RoleSociete::ExpertComptable || ! $attachement->lienValable()
+            || $declaration === null || ! $declaration->estDeclare() || $societe->estClose() || $societe->statut === StatutSociete::Revoquee
+            || $auteur === null || ! $auteur->estActif() || ! $auteur->estProprietaire()) {
+            self::prevenir($societe, 'E-mail non envoyé', "Le lien de {$compte->name} n'est pas parti : son compte ou votre déclaration n'est plus ouvert.");
+
+            return;
+        }
+
+        $cabinet = $declaration->nomDuCabinetDeclare();
+
+        try {
+            EnvoiImmediat::exiger("Le lien de {$compte->name}", fn () => Mail::to(ValeurRequise::de($compte->email, 'l\'adresse d\'un expert-comptable de la société'))->send(new LienDuMotDePasseDeLExpertComptableMail(
+                route('experts-comptables.lien.afficher', ['jeton' => $jeton]),
+                $compte->name,
+                $societe->getFilamentName(),
+                (string) $societe->siren,
+                $cabinet,
+                Calendrier::deParis()->afficher(ValeurRequise::de($attachement->jeton_expire_le, 'l\'échéance du lien'), 'd/m/Y à H:i'),
+                PermissionRegistry::libellesDe(app(TenantContext::class)->runAsSociete($societe, fn (): array => $declaration->autorisations())),
+                $accesRedonne ? $auteur->name : null,
+            )), 'Envoyez-lui un nouveau lien depuis sa fiche.');
+        } catch (CourrielNonParti $refus) {
+            app(TenantContext::class)->runAsSociete($societe, fn () => DB::transaction(function () use ($attachement): void {
+                CompteExpertComptable::query()->whereKey($attachement->getKey())->lockForUpdate()->first()?->oublierLeLien();
+            }));
+            self::prevenir($societe, 'E-mail non envoyé', "Le compte de {$compte->name} est créé, mais l'e-mail n'a pas pu partir : envoyez-lui un nouveau lien depuis sa fiche.");
+
+            throw $refus;
+        }
+    }
+
+    /**
+     * Prévient le propriétaire actuel de la société, dans sa cloche.
+     */
+    private static function prevenir(Societe $societe, string $titre, string $texte): void
+    {
+        $societe->proprietaire()->first()?->notify(new AvisDeLEquipe(
+            $societe,
+            $titre,
+            $texte,
+            CabinetComptable::getUrl(panel: 'societe', tenant: $societe),
+            'Voir le cabinet comptable',
+            AvisDeLEquipe::ATTENTION,
+        ));
+    }
+}
diff --git a/app/Domain/Cabinets/Services/ExpertsComptablesDeclares.php b/app/Domain/Cabinets/Services/ExpertsComptablesDeclares.php
new file mode 100644
index 0000000..a50a62a
--- /dev/null
+++ b/app/Domain/Cabinets/Services/ExpertsComptablesDeclares.php
@@ -0,0 +1,239 @@
+<?php
+
+namespace App\Domain\Cabinets\Services;
+
+use App\Domain\Cabinets\Enums\EtatDuLien;
+use App\Domain\Cabinets\Models\CompteExpertComptable;
+use App\Domain\Cabinets\Models\LienCabinet;
+use App\Domain\Tenancy\Actions\ChangerStatutCompteAction;
+use App\Domain\Tenancy\Enums\RoleSociete;
+use App\Domain\Tenancy\Enums\StatutCompte;
+use App\Domain\Tenancy\Enums\TypeDActivite;
+use App\Domain\Tenancy\Models\Magasin;
+use App\Domain\Tenancy\Models\Societe;
+use App\Domain\Tenancy\Scopes\SocieteScope;
+use App\Domain\Tenancy\Services\SessionsDesComptes;
+use App\Domain\Tenancy\Support\CleDuModele;
+use App\Domain\Tenancy\Support\ValeursLues;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Database\Eloquent\Collection;
+use Illuminate\Database\Query\Builder as RequeteSql;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Ce que l'on sait de l'expert-comptable d'une société, déclaré par le
+ * SIREN de son cabinet (voir DeclarerSonExpertComptableAction) : sa
+ * déclaration, une ligne de liens_cabinet sans cabinet, d'état declare
+ * tant qu'aucun cabinet vérifié de son SIREN ne s'y est rattaché, et ses
+ * comptes, des comptes de la société au rôle expert_comptable, attachés à
+ * elle pour toujours (voir CompteExpertComptable).
+ *
+ * Lectures hors de la société active, chacune filtrée et limitée aux
+ * colonnes qu'elle lit :
+ * - la déclaration d'un compte (declarationDe()) et ses autorisations, dans
+ *   la société du compte, lues aussi hors de tout contexte (connexion,
+ *   ouverture d'un magasin, nom figé du compte) ;
+ * - quand un cabinet devient vérifié, et chaque heure : le cabinet vérifié
+ *   d'un SIREN (cabinetVerifieDuSiren()) et les SIREN des déclarations en
+ *   attente dont le cabinet est vérifié (sirensAvecUnCabinetVerifie()).
+ * Aucune lecture ne mêle deux sociétés : un compte d'expert-comptable
+ * n'ouvre que les magasins réels de sa société.
+ */
+class ExpertsComptablesDeclares
+{
+    public function __construct(private readonly SessionsDesComptes $sessions) {}
+
+    /**
+     * La déclaration à laquelle ce compte est attaché, quel que soit son
+     * état, lue dans la société du compte, sans scope : null pour un compte
+     * qui n'est pas un expert-comptable de la société, ou sans attachement.
+     */
+    public function declarationDe(User $compte): ?LienCabinet
+    {
+        if ($compte->role_societe !== RoleSociete::ExpertComptable) {
+            return null;
+        }
+
+        return LienCabinet::query()->withoutGlobalScope(SocieteScope::class)
+            ->where('liens_cabinet.societe_id', $compte->societe_id)
+            ->whereIn('liens_cabinet.id', fn (RequeteSql $attachement) => $attachement
+                ->from('comptes_expert_comptable')
+                ->where('societe_id', $compte->societe_id)
+                ->where('user_id', $compte->getKey())
+                ->select('lien_id'))
+            ->first(['id', 'uuid', 'societe_id', 'etat', 'origine', 'siren_cabinet', 'denomination_cabinet', 'tous_les_magasins']);
+    }
+
+    /**
+     * La ligne d'attachement de ce compte à sa déclaration, dans sa société.
+     */
+    public function attachementDe(User $compte): ?CompteExpertComptable
+    {
+        return CompteExpertComptable::query()->withoutGlobalScope(SocieteScope::class)
+            ->where('societe_id', $compte->societe_id)
+            ->where('user_id', $compte->getKey())
+            ->first();
+    }
+
+    /**
+     * Les comptes non retirés de cette déclaration, par identifiant
+     * croissant, avec leur société ; sans les suspendus si demandé.
+     *
+     * @return Collection<int, User>
+     */
+    public function comptesDe(LienCabinet $declaration, bool $avecLesSuspendus = true): Collection
+    {
+        return User::query()
+            ->with('societe')
+            ->where('societe_id', $declaration->societe_id)
+            ->where('role_societe', RoleSociete::ExpertComptable->value)
+            ->where('statut', '<>', StatutCompte::Retire->value)
+            ->when(! $avecLesSuspendus, fn (Builder $comptes) => $comptes->where('statut', StatutCompte::Actif->value))
+            ->whereIn('id', fn (RequeteSql $attaches) => $attaches
+                ->from('comptes_expert_comptable')
+                ->where('societe_id', $declaration->societe_id)
+                ->where('lien_id', $declaration->getKey())
+                ->select('user_id'))
+            ->orderBy('id')
+            ->get();
+    }
+
+    /**
+     * Une de ses personnes a-t-elle encore un compte actif ? Sans elle, une
+     * déclaration ne se rattache pas (voir RattacherUneDeclarationAction).
+     */
+    public function aUnCompteActif(LienCabinet $declaration): bool
+    {
+        return $this->comptesDe($declaration, avecLesSuspendus: false)->isNotEmpty();
+    }
+
+    /**
+     * Les magasins réels de sa société que la déclaration de ce compte lui
+     * ouvre, par identifiant croissant : tous, présents et futurs, ou ceux
+     * que le propriétaire a choisis, tant que la déclaration est en
+     * attente ; aucun sinon, ni pour un compte retiré. Jamais le magasin de
+     * démonstration.
+     *
+     * @return list<int>
+     */
+    public function idsDesMagasinsOuverts(User $compte): array
