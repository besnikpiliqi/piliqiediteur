diff --git a/app/Policies/FactureAchatPolicy.php b/app/Policies/FactureAchatPolicy.php
index b98058c..d5b68d2 100644
--- a/app/Policies/FactureAchatPolicy.php
+++ b/app/Policies/FactureAchatPolicy.php
@@ -53,6 +53,27 @@ public function valider(User $user, FactureAchat $factureAchat): bool
         return $this->view($user, $factureAchat) && $user->can(PermissionRegistry::FACTURE_ACHAT_VALIDER);
     }
 
+    /**
