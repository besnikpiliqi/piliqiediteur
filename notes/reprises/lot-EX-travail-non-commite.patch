+    /**
+     * Le nombre de requêtes d'un clic sur un raccourci de la page, sa
+     * réponse comprise.
+     */
+    private function requetesDuClic(Testable $page): int
+    {
+        DB::flushQueryLog();
+        DB::enableQueryLog();
+        $page->call('raccourci', 'mois_dernier');
+        $nombre = count(DB::getQueryLog());
+        DB::disableQueryLog();
+
+        return $nombre;
+    }
