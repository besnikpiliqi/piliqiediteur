@@ -0,0 +1,320 @@
+<?php
+
+namespace App\Domain\Facturation\Services;
+
+use App\Domain\Achats\Enums\StatutAvoirFournisseur;
+use App\Domain\Achats\Enums\StatutFactureAchat;
+use App\Domain\Achats\Models\AvoirFournisseur;
+use App\Domain\Achats\Models\FactureAchat;
+use App\Domain\Authorization\PermissionRegistry;
+use App\Domain\Cabinets\Services\AccesDesCabinets;
+use App\Domain\Calendrier\Calendrier;
+use App\Domain\Facturation\Enums\OrigineDesAchats;
+use App\Domain\Facturation\Enums\StatutAvoir;
+use App\Domain\Facturation\Enums\TypeDeDocumentTelechargeable;
+use App\Domain\Facturation\Models\Avoir;
+use App\Domain\Facturation\Models\ClotureCaisse;
+use App\Domain\Facturation\Models\Facture;
+use App\Domain\Facturation\Models\Paiement;
+use App\Domain\Tenancy\Models\Magasin;
+use App\Domain\Tenancy\Models\Societe;
+use App\Domain\Tenancy\Services\TenantContext;
+use App\Models\User;
+use Closure;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\Gate;
+
+/**
+ * Les documents du téléchargement par période (décision de l'éditeur du
+ * 03/11/2026, lot EX) : une lecture hors du magasin courant, déclarée dans
+ * CLAUDE.md, dans l'espace de la société (les magasins de la portée de la
+ * personne) et dans l'espace d'un cabinet (les magasins réels d'un client
+ * lié qui le lui accorde).
+ *
+ * Chaque magasin se lit à son tour comme magasin actif, sa société comme
+ * société active (voir dansLeMagasin()) : MagasinScope reste en place, aucune requête ne
+ * contourne sa portée, et chaque droit se pose à la Gate dans ce magasin
+ * (voir ControleDesDroits), la lecture seule d'un magasin fermé, suspendu
+ * ou d'une société résiliée laissant le téléchargement permis. Un magasin
+ * n'est lu que si la personne y a l'autorisation « télécharger les
+ * documents par période » (voir peutTelechargerDans()) ; un magasin réel
+ * d'une société qui n'est pas validée n'a aucun document réel et n'est
+ * jamais lu ; le magasin de démonstration se lit, ses documents marqués
+ * comme tels.
+ *
+ * Chacun ne reçoit que les documents qu'il peut voir, type par type, comme
+ * leurs listes le font (voir typesVisibles()) : les ventes qu'il voit (les
+ * siennes, ou toutes avec « voir celles de toute l'équipe », voir
+ * Facture::scopeVisiblesPar()), les avoirs de même (voir
+ * Avoir::scopeVisiblesPar()), les achats et les avoirs fournisseur de
+ * l'équipe, les clôtures qu'il a déclenchées ou toutes (voir
+ * ClotureCaissePolicy), les encaissements qu'il a enregistrés ou tous (voir
+ * PaiementPolicy) ; jamais un brouillon. Les jours sont ceux du calendrier
+ * de chaque magasin : le jour d'émission d'une vente, d'un avoir et d'un
+ * avoir fournisseur, la date de la facture du fournisseur d'un achat (à
+ * défaut, pour un achat reçu par l'API, le jour de sa validation), la
+ * journée d'une clôture, le jour d'enregistrement d'un paiement. Les
+ * montants sont ceux qu'enregistre chaque document, additionnés en
+ * centimes pour un relevé des encaissements, jamais par la base.
+ */
+final class DocumentsDeLaPeriode
+{
+    public function __construct(
+        private readonly TenantContext $contexte,
+        private readonly CalculateurLigne $calculateur,
+    ) {}
+
+    /**
+     * Ce magasin, s'il y télécharge.
+     *
+     * @return Collection<int, Magasin>
+     */
+    public function magasinsDuMagasin(User $compte, Magasin $magasin): Collection
+    {
+        return collect([$magasin])->filter(fn (Magasin $candidat): bool => $this->peutTelechargerDans($compte, $candidat))->values();
+    }
+
+    /**
+     * Les magasins de sa société dans sa portée (tous pour le propriétaire,
+     * la sélection d'un administrateur, voir User::magasinsDeSaPortee()) où
+     * il télécharge, les magasins réels d'abord, par nom.
+     *
+     * @return Collection<int, Magasin>
+     */
+    public function magasinsDeLaSociete(User $compte, Societe $societe): Collection
+    {
+        if ((int) $compte->societe_id !== (int) $societe->getKey() || ! $compte->peutAdministrer()) {
+            return collect();
+        }
+
+        return $compte->magasinsDeSaPortee()
+            ->orderBy('est_demonstration')
+            ->orderBy('nom')
+            ->orderBy('id')
+            ->get()
+            ->filter(fn (Magasin $magasin): bool => $this->peutTelechargerDans($compte, $magasin))
+            ->values();
+    }
+
+    /**
+     * Les magasins réels de ce client lié que le cabinet ouvre au compte
+     * (son propriétaire, ou le collaborateur à qui il est confié, voir
+     * AccesDesCabinets::magasinsOuverts()) et où le client accorde au
+     * cabinet le téléchargement par période.
+     *
+     * @return Collection<int, Magasin>
+     */
+    public function magasinsDuClient(User $compte, Societe $client): Collection
+    {
+        if (! $compte->estDUnCabinet()) {
+            return collect();
+        }
+
+        return app(AccesDesCabinets::class)->magasinsOuverts($compte)
+            ->where('societe_id', $client->getKey())
+            ->filter(fn (Magasin $magasin): bool => $this->peutTelechargerDans($compte, $magasin))
+            ->values();
+    }
+
+    /**
+     * A-t-il, dans ce magasin, l'autorisation de télécharger les documents
+     * par période, posée à la Gate dans ce magasin ? Jamais dans un magasin
+     * réel d'une société qui n'est pas validée, qui n'a aucun document réel.
+     */
+    public function peutTelechargerDans(User $compte, Magasin $magasin): bool
+    {
+        if (! $magasin->est_demonstration && ! $magasin->societe->estValidee()) {
+            return false;
+        }
+
+        return $this->dansLeMagasin($magasin, fn (): bool => Gate::forUser($compte)->allows(PermissionRegistry::DOCUMENTS_TELECHARGER));
+    }
+
+    /**
+     * Les types de documents qu'il voit dans ce magasin, dans l'ordre de
+     * l'énumération, ceux qui existent dans le type d'activité de sa
+     * société seulement.
+     *
+     * @return list<TypeDeDocumentTelechargeable>
+     */
+    public function typesVisibles(User $compte, Magasin $magasin): array
+    {
+        return $this->dansLeMagasin($magasin, fn (): array => array_values(array_filter(
+            TypeDeDocumentTelechargeable::cases(),
+            fn (TypeDeDocumentTelechargeable $type): bool => $type->existeDans($magasin->societe->type_activite) && Gate::forUser($compte)->allows('viewAny', $type->modele()),
+        )));
+    }
+
+    /**
+     * Les documents de ces types, du jour $du au jour $au compris, dans
+     * chacun de ces magasins où il télécharge, ceux qu'il peut voir
+     * seulement, magasin par magasin puis type par type, chacun dans
+     * l'ordre de ses jours.
+     *
+     * @param  iterable<Magasin>  $magasins
+     * @param  list<TypeDeDocumentTelechargeable>  $types
+     * @return list<DocumentTrouve>
+     */
+    public function trouver(User $compte, iterable $magasins, string $du, string $au, array $types, OrigineDesAchats $origine): array
+    {
+        $documents = [];
+
+        foreach ($magasins as $magasin) {
+            if (! $this->peutTelechargerDans($compte, $magasin)) {
+                continue;
+            }
+
+            $visibles = array_values(array_filter($this->typesVisibles($compte, $magasin), fn (TypeDeDocumentTelechargeable $type): bool => in_array($type, $types, true)));
+            $documents = [...$documents, ...$this->dansLeMagasin($magasin, fn (): array => $this->duMagasin($compte, $magasin, $du, $au, $visibles, $origine))];
+        }
+
+        return $documents;
+    }
+
+    /**
+     * Ceux de ces documents dont la clé est choisie, relus comme trouver()
+     * les trouve : une clé qui ne désigne aucun document que la personne
+     * peut voir ne désigne rien.
+     *
+     * @param  iterable<Magasin>  $magasins
+     * @param  list<TypeDeDocumentTelechargeable>  $types
+     * @param  list<string>  $cles
+     * @return list<DocumentTrouve>
+     */
+    public function choisis(User $compte, iterable $magasins, string $du, string $au, array $types, OrigineDesAchats $origine, array $cles): array
+    {
+        $choisies = array_flip($cles);
+
+        return array_values(array_filter(
+            $this->trouver($compte, $magasins, $du, $au, $types, $origine),
+            fn (DocumentTrouve $document): bool => isset($choisies[$document->cle()]),
+        ));
+    }
+
+    /**
+     * Exécute ce callback avec ce magasin pour magasin actif et sa société
+     * pour société active, d'où qu'il parte (l'espace d'un cabinet pose la
+     * société du cabinet, celui d'une société la sienne), puis restaure le
+     * contexte d'avant.
+     */
+    public function dansLeMagasin(Magasin $magasin, Closure $callback): mixed
+    {
+        return $this->contexte->runAsSociete($magasin->societe, fn (): mixed => $this->contexte->runAs($magasin, $callback));
+    }
+
+    /**
+     * Les paiements d'un relevé des encaissements qu'il voit : enregistrés
+     * dans le magasin actif de $du à $au compris, dans son calendrier, ceux
+     * qu'il a enregistrés, ou tous avec « voir celles de toute l'équipe »,
+     * dans l'ordre de leur enregistrement.
+     *
+     * @return Builder<Paiement>
+     */
+    public function paiementsVisibles(User $compte, Calendrier $calendrier, string $du, string $au): Builder
+    {
+        [$debut] = $calendrier->bornesDuJour($du);
+        [, $fin] = $calendrier->bornesDuJour($au);
+
+        return Paiement::query()
+            ->where('created_at', '>=', $debut)
+            ->where('created_at', '<', $fin)
+            ->when(! Gate::forUser($compte)->allows(PermissionRegistry::FACTURE_VIEW_TOUTES), fn (Builder $paiements): Builder => $paiements->where('cree_par', $compte->getKey()))
+            ->orderBy('created_at')
+            ->orderBy('id');
+    }
+
+    /**
+     * Le dernier jour de ce mois (AAAA-MM).
+     */
+    public static function dernierJourDuMois(string $mois): string
+    {
+        return Calendrier::ajouterJours(Calendrier::jourDuMoisSuivant($mois.'-01', 1), -1);
+    }
+
+    /**
+     * @param  list<TypeDeDocumentTelechargeable>  $types
+     * @return list<DocumentTrouve>
+     */
+    private function duMagasin(User $compte, Magasin $magasin, string $du, string $au, array $types, OrigineDesAchats $origine): array
+    {
+        $calendrier = $magasin->calendrier();
+        [$debut] = $calendrier->bornesDuJour($du);
+        [, $fin] = $calendrier->bornesDuJour($au);
+        $nom = "{$magasin->nom} ({$magasin->code})";
+        $documents = [];
+        $document = fn (TypeDeDocumentTelechargeable $type, string|int $identifiant, ?string $numero, string $jour, ?string $tiers, mixed $ttc, ?string $origine = null): DocumentTrouve => new DocumentTrouve($type, $magasin->getKey(), $nom, (string) $identifiant, (string) $numero, $jour, $tiers, is_int($ttc) ? $ttc : $this->calculateur->enCentiemes($ttc), $origine);
+
+        foreach ($types as $type) {
+            $documents = [...$documents, ...match ($type) {
+                TypeDeDocumentTelechargeable::Ventes => Facture::query()->emises()->visiblesPar($compte)
+                    ->where('date_emission', '>=', $debut)->where('date_emission', '<', $fin)
+                    ->orderBy('date_emission')->orderBy('id')
+                    ->get(['id', 'numero', 'date_emission', 'client_nom', 'total_ttc'])
+                    ->map(fn (Facture $facture): DocumentTrouve => $document($type, $facture->id, $facture->numero, $calendrier->jourDe($facture->date_emission), $facture->client_nom, $facture->total_ttc))
+                    ->all(),
+                TypeDeDocumentTelechargeable::AvoirsClients => Avoir::query()->where('statut', StatutAvoir::Emise)->visiblesPar($compte)
+                    ->where('date_emission', '>=', $debut)->where('date_emission', '<', $fin)
+                    ->orderBy('date_emission')->orderBy('id')
+                    ->get(['id', 'numero', 'date_emission', 'client_nom', 'total_ttc'])
+                    ->map(fn (Avoir $avoir): DocumentTrouve => $document($type, $avoir->id, $avoir->numero, $calendrier->jourDe($avoir->date_emission), $avoir->client_nom, $avoir->total_ttc))
+                    ->all(),
+                TypeDeDocumentTelechargeable::FacturesAchat => FactureAchat::query()->with('fournisseur')
+                    ->where('statut', StatutFactureAchat::Validee)
+                    ->whereIn('source', $origine->sources())
+                    ->where(fn (Builder $factures): Builder => $factures->whereBetween('date_facture', [$du, $au])
+                        ->orWhere(fn (Builder $sansDate): Builder => $sansDate->whereNull('date_facture')->where('date_validation', '>=', $debut)->where('date_validation', '<', $fin)))
+                    ->orderBy('rang_validation')
+                    ->get()
+                    ->map(fn (FactureAchat $facture): DocumentTrouve => $document($type, $facture->id, $facture->numero, $facture->date_facture ?? $calendrier->jourDe($facture->date_validation), $facture->fournisseur->nom, $facture->total_ttc, $facture->source->getLabel()))
+                    ->sortBy(fn (DocumentTrouve $trouve): string => $trouve->jour)
+                    ->values()
+                    ->all(),
+                TypeDeDocumentTelechargeable::AvoirsFournisseur => AvoirFournisseur::query()->with('factureAchat.fournisseur')
+                    ->where('statut', StatutAvoirFournisseur::Emise)
+                    ->whereIn('source', $origine->sources())
+                    ->where('date_emission', '>=', $debut)->where('date_emission', '<', $fin)
+                    ->orderBy('date_emission')->orderBy('numero')
+                    ->get()
+                    ->map(fn (AvoirFournisseur $avoir): DocumentTrouve => $document($type, $avoir->id, $avoir->numero, $calendrier->jourDe($avoir->date_emission), $avoir->factureAchat->fournisseur->nom, $avoir->total_ttc, $avoir->source->getLabel()))
+                    ->all(),
+                TypeDeDocumentTelechargeable::Clotures => ClotureCaisse::query()
+                    ->whereBetween('date_cloture', [$du, $au])
+                    ->when(! Gate::forUser($compte)->allows(PermissionRegistry::CLOTURE_CAISSE_VIEW_TOUTES), fn (Builder $clotures): Builder => $clotures->where('cree_par', $compte->getKey()))
+                    ->orderBy('date_cloture')
+                    ->get(['id', 'numero', 'date_cloture', 'total_ttc'])
+                    ->map(fn (ClotureCaisse $cloture): DocumentTrouve => $document($type, $cloture->id, $cloture->numero, $cloture->date_cloture, null, $cloture->total_ttc))
+                    ->all(),
+                TypeDeDocumentTelechargeable::Encaissements => $this->relevesDesEncaissements($compte, $calendrier, $du, $au, $document),
+            }];
+        }
+
+        return $documents;
+    }
+
+    /**
+     * Un relevé des encaissements par mois qui a des paiements que la
+     * personne voit dans la période : son jour est le dernier de ce mois
+     * dans la période, son TTC le total encaissé, contre-passations
+     * déduites.
+     *
+     * @param  callable(TypeDeDocumentTelechargeable, string|int, ?string, string, ?string, mixed, ?string=): DocumentTrouve  $document
+     * @return list<DocumentTrouve>
+     */
+    private function relevesDesEncaissements(User $compte, Calendrier $calendrier, string $du, string $au, callable $document): array
+    {
+        return $this->paiementsVisibles($compte, $calendrier, $du, $au)
+            ->get(['id', 'montant', 'created_at'])
+            ->groupBy(fn (Paiement $paiement): string => substr($calendrier->jourDe($paiement->created_at), 0, 7))
+            ->map(fn (Collection $paiements, string $mois): DocumentTrouve => $document(
+                TypeDeDocumentTelechargeable::Encaissements,
+                $mois,
+                'Encaissements '.$mois,
+                min($au, self::dernierJourDuMois($mois)),
+                null,
+                (int) $paiements->sum(fn (Paiement $paiement): int => $this->calculateur->enCentiemes($paiement->montant)),
+            ))
+            ->values()
+            ->all();
+    }
+}
diff --git a/app/Domain/Facturation/Services/RecapitulatifDesDocuments.php b/app/Domain/Facturation/Services/RecapitulatifDesDocuments.php
new file mode 100644
index 0000000..d35a7a6
--- /dev/null
+++ b/app/Domain/Facturation/Services/RecapitulatifDesDocuments.php
@@ -0,0 +1,254 @@
+<?php
+
+namespace App\Domain\Facturation\Services;
+
+use App\Domain\Achats\Models\AvoirFournisseur;
+use App\Domain\Achats\Models\FactureAchat;
+use App\Domain\Achats\Models\TauxAvoirFournisseur;
+use App\Domain\Achats\Models\TauxFactureAchat;
+use App\Domain\Calendrier\Calendrier;
+use App\Domain\Contacts\Models\Fournisseur;
+use App\Domain\Facturation\Enums\ModePaiement;
+use App\Domain\Facturation\Enums\TypeDeDocumentTelechargeable;
+use App\Domain\Facturation\Models\Avoir;
+use App\Domain\Facturation\Models\AvoirAllocation;
+use App\Domain\Facturation\Models\ClotureCaisse;
+use App\Domain\Facturation\Models\Facture;
+use App\Domain\Facturation\Models\PaiementAllocation;
+use App\Domain\Tenancy\Models\Magasin;
+use App\Models\User;
+use DateTimeInterface;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Support\Collection;
+
+/**
+ * Le récapitulatif du téléchargement par période, « Récapitulatif (CSV) »
+ * (décision de l'éditeur du 03/11/2026, E2) : un fichier CSV qui s'ouvre
+ * dans Excel (UTF-8 avec sa marque d'ordre des octets, séparateur « ; »,
+ * virgule décimale, jours JJ/MM/AAAA), une ligne par document et par taux
+ * de TVA : son type, son magasin, son numéro, son jour, son tiers (nom et
+ * identifiant tels que le document les a figés ; pour un achat, son
+ * fournisseur), l'origine d'un achat, la base HT, le taux, la TVA et le TTC
+ * de chaque taux, puis, sur la première ligne d'une vente, ce qui en était
+ * payé et ce qui en restait dû à la fin du dernier jour de la période,
+ * dans le calendrier de son magasin. Une clôture du jour donne le net de
+ * chaque taux de ses ventes aux particuliers ; un relevé des encaissements
+ * une ligne par mode, avec son mode, et une ligne pour le crédit d'avoir
+ * utilisé ; un texte qui commencerait comme une formule est désamorcé
+ * (voir texte()). Les montants sont ceux qu'enregistre chaque document,
+ * additionnés en centimes par taux, jamais recalculés ni additionnés par la
+ * base. Chaque document se relit dans son magasin, comme magasin actif
+ * (voir DocumentsDeLaPeriode::dansLeMagasin()).
+ */
+final class RecapitulatifDesDocuments
+{
+    public const COLONNES = ['Type', 'Magasin', 'Numéro', 'Date', 'Tiers', 'Identifiant du tiers', 'Origine', 'Mode de paiement', 'Taux de TVA', 'Base HT', 'TVA', 'TTC', 'Payé à la fin de la période', 'Restant dû à la fin de la période'];
+
+    public function __construct(
+        private readonly CalculateurLigne $calculateur,
+        private readonly DocumentsDeLaPeriode $documents,
+    ) {}
+
+    /**
+     * Le contenu du fichier CSV de ces documents.
+     *
+     * @param  list<DocumentTrouve>  $documents
+     */
+    public function ecrire(User $compte, array $documents, string $du, string $au): string
+    {
+        $flux = fopen('php://temp', 'r+');
+        fwrite($flux, "\xEF\xBB\xBF");
+        fputcsv($flux, self::COLONNES, ';', '"', '', "\r\n");
+
+        foreach (collect($documents)->groupBy(fn (DocumentTrouve $document): int => $document->magasinId) as $magasinId => $duMagasin) {
+            $magasin = Magasin::query()->findOrFail($magasinId);
+
+            $this->documents->dansLeMagasin($magasin, function () use ($compte, $magasin, $duMagasin, $du, $au, $flux): void {
+                foreach ($duMagasin as $document) {
+                    foreach ($this->lignes($compte, $magasin, $document, $du, $au) as $ligne) {
+                        fputcsv($flux, $ligne, ';', '"', '', "\r\n");
+                    }
+                }
+            });
+        }
+
+        rewind($flux);
+        $contenu = (string) stream_get_contents($flux);
+        fclose($flux);
+
+        return $contenu;
+    }
+
+    /**
+     * Les lignes d'un document.
+     *
+     * @return list<list<string>>
+     */
+    private function lignes(User $compte, Magasin $magasin, DocumentTrouve $document, string $du, string $au): array
+    {
+        $ligne = fn (array $taux, ?string $tiers = null, ?string $identifiant = null, ?string $mode = null, ?array $reglement = null): array => [
+            $document->type->libelleDUnDocument(),
+            self::texte($document->magasin),
+            self::texte($document->numero),
+            Calendrier::afficherJour($document->jour, 'd/m/Y'),
+            self::texte($tiers ?? $document->tiers ?? ''),
+            self::texte($identifiant ?? ''),
+            $document->origine ?? '',
+            $mode ?? '',
+            $taux['taux'] ?? '',
+            isset($taux['ht']) ? self::montant($taux['ht']) : '',
+            isset($taux['tva']) ? self::montant($taux['tva']) : '',
+            self::montant($taux['ttc']),
+            $reglement === null ? '' : self::montant($reglement[0]),
+            $reglement === null ? '' : self::montant($reglement[1]),
+        ];
+
+        switch ($document->type) {
+            case TypeDeDocumentTelechargeable::Ventes:
+                $facture = Facture::query()->with('lignes')->findOrFail($document->identifiant);
+                $paye = $this->payeA($facture, $magasin->calendrier()->bornesDuJour($au)[1]);
+
+                return $this->parTaux($facture->lignes)->values()->map(fn (array $taux, int $rang): array => $ligne(
+                    $taux,
+                    identifiant: self::identifiantDuClient($facture),
+                    reglement: $rang === 0 ? [$paye, $this->calculateur->enCentiemes($facture->total_ttc) - $paye] : null,
+                ))->all();
+            case TypeDeDocumentTelechargeable::AvoirsClients:
+                $avoir = Avoir::query()->with('lignes')->findOrFail($document->identifiant);
+
+                return $this->parTaux($avoir->lignes)->values()->map(fn (array $taux): array => $ligne($taux, identifiant: self::identifiantDuClient($avoir)))->all();
+            case TypeDeDocumentTelechargeable::FacturesAchat:
+            case TypeDeDocumentTelechargeable::AvoirsFournisseur:
+                $achat = $document->type === TypeDeDocumentTelechargeable::FacturesAchat
+                    ? FactureAchat::query()->with(['taux', 'fournisseur'])->findOrFail($document->identifiant)
+                    : AvoirFournisseur::query()->with(['taux', 'factureAchat.fournisseur'])->findOrFail($document->identifiant);
+                $fournisseur = $achat instanceof FactureAchat ? $achat->fournisseur : $achat->factureAchat->fournisseur;
+
+                return $achat->taux->map(fn (TauxFactureAchat|TauxAvoirFournisseur $taux): array => $ligne([
+                    'taux' => self::taux($taux->taux_tva),
+                    'ht' => $this->calculateur->enCentiemes($taux->base_ht),
+                    'tva' => $this->calculateur->enCentiemes($taux->montant_tva),
+                    'ttc' => $this->calculateur->enCentiemes($taux->base_ht) + $this->calculateur->enCentiemes($taux->montant_tva),
+                ], identifiant: self::identifiantDuFournisseur($fournisseur)))->values()->all();
+            case TypeDeDocumentTelechargeable::Clotures:
+                $cloture = ClotureCaisse::query()->findOrFail($document->identifiant);
+                $nets = $cloture->netParTaux();
+
+                return $nets === []
+                    ? [$ligne(['ht' => 0, 'tva' => 0, 'ttc' => 0])]
+                    : array_map(fn (array $taux): array => $ligne([...$taux, 'taux' => self::taux($taux['taux'] / 100)]), $nets);
+            case TypeDeDocumentTelechargeable::Encaissements:
+                return $this->lignesDuReleve($compte, $magasin, $document, $du, $au, $ligne);
+        }
+    }
+
+    /**
+     * Une ligne par mode qui a des paiements, puis le crédit d'avoir
+     * utilisé, s'il y en a.
+     *
+     * @param  callable(array<string, mixed>, ?string=, ?string=, ?string=, ?array<int, int>=): list<string>  $ligne
+     * @return list<list<string>>
+     */
+    private function lignesDuReleve(User $compte, Magasin $magasin, DocumentTrouve $document, string $du, string $au, callable $ligne): array
+    {
+        $calendrier = $magasin->calendrier();
+        $premier = max($du, $document->identifiant.'-01');
+        $dernier = min($au, DocumentsDeLaPeriode::dernierJourDuMois($document->identifiant));
+        $paiements = $this->documents->paiementsVisibles($compte, $calendrier, $premier, $dernier)->get(['id', 'mode_paiement', 'montant']);
+        [$debut] = $calendrier->bornesDuJour($premier);
+        [, $fin] = $calendrier->bornesDuJour($dernier);
+        $credit = (int) AvoirAllocation::query()
+            ->where('created_at', '>=', $debut)
+            ->where('created_at', '<', $fin)
+            ->whereIn('facture_id', Facture::query()->visiblesPar($compte)->select('id'))
+            ->pluck('montant_alloue')
+            ->sum(fn (mixed $montant): int => $this->calculateur->enCentiemes($montant));
+        $lignes = [];
+
+        foreach ([...ModePaiement::aLaCaisse(), ModePaiement::Prelevement] as $mode) {
+            $duMode = $paiements->filter(fn ($paiement): bool => $paiement->mode_paiement === $mode);
+
+            if ($duMode->isNotEmpty()) {
+                $lignes[] = $ligne(['ttc' => (int) $duMode->sum(fn ($paiement): int => $this->calculateur->enCentiemes($paiement->montant))], mode: $mode->getLabel());
+            }
+        }
+
+        if ($credit !== 0) {
+            $lignes[] = $ligne(['ttc' => $credit], mode: 'Avoir (crédit utilisé)');
+        }
+
+        return $lignes;
+    }
+
+    /**
+     * Les montants de ces lignes, additionnés en centimes taux par taux,
+     * du plus fort au plus faible.
+     *
+     * @param  Collection<int, Model>  $lignes
+     * @return Collection<string, array{taux: string, ht: int, tva: int, ttc: int}>
+     */
+    private function parTaux(Collection $lignes): Collection
+    {
+        return $lignes
+            ->groupBy(fn (Model $ligne): string => number_format((float) $ligne->taux_tva, 2, '.', ''))
+            ->sortKeysUsing(fn (string $a, string $b): int => (float) $b <=> (float) $a)
+            ->map(fn (Collection $duTaux, string $taux): array => [
+                'taux' => self::taux($taux),
+                'ht' => (int) $duTaux->sum(fn (Model $ligne): int => $this->calculateur->enCentiemes($ligne->montant_ht)),
+                'tva' => (int) $duTaux->sum(fn (Model $ligne): int => $this->calculateur->enCentiemes($ligne->montant_tva)),
+                'ttc' => (int) $duTaux->sum(fn (Model $ligne): int => $this->calculateur->enCentiemes($ligne->montant_ttc)),
+            ]);
+    }
+
+    /**
+     * Ce que la facture avait reçu avant cet instant : ses paiements et le
+     * crédit d'avoir imputé, contre-passations déduites, en centimes.
+     */
+    private function payeA(Facture $facture, DateTimeInterface $instant): int
+    {
+        return (int) PaiementAllocation::query()->where('facture_id', $facture->getKey())->where('created_at', '<', $instant)->pluck('montant_alloue')
+            ->concat(AvoirAllocation::query()->where('facture_id', $facture->getKey())->where('created_at', '<', $instant)->pluck('montant_alloue'))
+            ->sum(fn (mixed $montant): int => $this->calculateur->enCentiemes($montant));
+    }
+
+    private static function identifiantDuClient(Facture|Avoir $document): string
+    {
+        return $document->client_siret ?? $document->client_siren ?? $document->client_numero_tva ?? $document->client_identifiant_etranger ?? '';
+    }
+
+    private static function identifiantDuFournisseur(Fournisseur $fournisseur): string
+    {
+        return $fournisseur->siret ?? $fournisseur->numero_tva ?? '';
+    }
+
+    /**
+     * Un taux tel qu'il s'écrit : « 20 », « 5,5 ».
+     */
+    private static function taux(mixed $taux): string
+    {
+        return str_replace('.', ',', rtrim(rtrim(number_format((float) $taux, 2, '.', ''), '0'), '.'));
+    }
+
+    /**
+     * Un texte saisi par une personne (un nom de magasin, de client ou de
+     * fournisseur, un numéro, un identifiant) tel qu'il s'écrit dans le
+     * fichier : précédé d'une apostrophe quand il commence comme une
+     * formule (=, +, -, @, une tabulation ou un retour chariot), qu'Excel
+     * exécuterait à l'ouverture au lieu de l'afficher.
+     */
+    private static function texte(string $valeur): string
+    {
+        return preg_match('/^[=+\-@\t\r]/', $valeur) === 1 ? "'".$valeur : $valeur;
+    }
+
+    /**
+     * Un montant en centimes tel que l'écrit Excel en français : « 1234,56 »,
+     * « -12,00 », sans séparateur des milliers.
+     */
+    private static function montant(int $centimes): string
+    {
+        $absolu = abs($centimes);
+
+        return ($centimes < 0 ? '-' : '').intdiv($absolu, 100).','.str_pad((string) ($absolu % 100), 2, '0', STR_PAD_LEFT);
+    }
+}
diff --git a/app/Domain/Facturation/Services/ReleveDesEncaissementsPdfGenerator.php b/app/Domain/Facturation/Services/ReleveDesEncaissementsPdfGenerator.php
new file mode 100644
index 0000000..45b9b61
--- /dev/null
+++ b/app/Domain/Facturation/Services/ReleveDesEncaissementsPdfGenerator.php
@@ -0,0 +1,135 @@
+<?php
+
+namespace App\Domain\Facturation\Services;
+
+use App\Domain\Calendrier\Calendrier;
+use App\Domain\Facturation\Enums\ModePaiement;
+use App\Domain\Facturation\Models\AvoirAllocation;
+use App\Domain\Facturation\Models\Facture;
+use App\Domain\Facturation\Models\Paiement;
+use App\Domain\Facturation\Models\PaiementAllocation;
+use App\Domain\Tenancy\Exceptions\VenteNonAutoriseeException;
+use App\Domain\Tenancy\Models\Magasin;
+use App\Models\User;
+use Barryvdh\DomPDF\PDF as PdfDocument;
+use Illuminate\Support\Collection;
+
+/**
+ * Le relevé des encaissements d'un magasin pour un mois, dans les jours de
+ * ce mois que couvre la période du téléchargement (décision de l'éditeur du
+ * 03/11/2026, E1 ; voir ArchiveDesDocuments) : une vraie page A4 en
+ * portrait comme les autres PDF (voir MiseEnPageA4), le magasin en tête,
+ * puis les encaissements par mode, dans l'ordre de la caisse (espèces,
+ * carte bancaire, chèque, virement, puis prélèvement), chacun avec son
+ * nombre de paiements et de contre-passations et son montant,
+ * contre-passations déduites ; le crédit d'avoir utilisé, à part, qui ne
+ * fait entrer aucun argent ; puis chaque paiement (jour, mode, référence,
+ * documents qu'il règle, montant). Seulement ce que la personne voit (voir
+ * DocumentsDeLaPeriode::paiementsVisibles()), chaque jour dans le
+ * calendrier du magasin, chaque montant tel qu'il est enregistré,
+ * additionné en centimes. Le magasin actif est celui du relevé.
+ */
+class ReleveDesEncaissementsPdfGenerator
+{
+    public function __construct(
+        private readonly MiseEnPageA4 $miseEnPage,
+        private readonly CalculateurLigne $calculateur,
+        private readonly DocumentsDeLaPeriode $documents,
+    ) {}
+
+    /**
+     * @param  string  $mois  AAAA-MM
+     * @param  string  $du  le premier jour de la période, AAAA-MM-JJ
+     * @param  string  $au  le dernier jour de la période, AAAA-MM-JJ
+     *
+     * @throws VenteNonAutoriseeException
+     */
+    public function generer(User $compte, Magasin $magasin, string $mois, string $du, string $au): PdfDocument
+    {
+        return $this->miseEnPage->pdf($this->html($compte, $magasin, $mois, $du, $au));
+    }
+
+    /**
+     * @throws VenteNonAutoriseeException
+     */
+    public function html(User $compte, Magasin $magasin, string $mois, string $du, string $au): string
+    {
+        $magasin->verifierQuIlPeutImprimer();
+        $calendrier = $magasin->calendrier();
+        $premier = max($du, $mois.'-01');
+        $dernier = min($au, DocumentsDeLaPeriode::dernierJourDuMois($mois));
+        $paiements = $this->documents->paiementsVisibles($compte, $calendrier, $premier, $dernier)
+            ->with(['allocations.facture:id,numero'])
+            ->get();
+        [$debut] = $calendrier->bornesDuJour($premier);
+        [, $fin] = $calendrier->bornesDuJour($dernier);
+        $credit = AvoirAllocation::query()
+            ->where('created_at', '>=', $debut)
+            ->where('created_at', '<', $fin)
+            ->whereIn('facture_id', Facture::query()->visiblesPar($compte)->select('id'))
+            ->pluck('montant_alloue')
+            ->sum(fn (mixed $montant): int => $this->calculateur->enCentiemes($montant));
+        $emetteur = Emetteur::duMagasin($magasin);
+        $euros = fn (int $centimes): string => $this->calculateur->enEuros($centimes);
+
+        return view('encaissements.pdf', [
+            'emetteur' => $emetteur,
+            'pied' => PiedDePage::pourUnRecu($emetteur),
+            'titre' => 'Relevé des encaissements',
+            'details' => [
+                ucfirst(Calendrier::nomDuMois((int) substr($mois, 5, 2))).' '.substr($mois, 0, 4),
+                'Du '.Calendrier::afficherJour($premier, 'd/m/Y').' au '.Calendrier::afficherJour($dernier, 'd/m/Y'),
+            ],
+            'modes' => $this->parMode($paiements, $euros),
+            'total' => $euros($this->total($paiements)),
+            'credit' => $euros((int) $credit),
+            'paiements' => $paiements->map(fn (Paiement $paiement): array => [
+                'jour' => $calendrier->afficher($paiement->created_at, 'd/m/Y'),
+                'mode' => $paiement->mode_paiement->getLabel().($paiement->estUneContrePassation() ? ' (contre-passation)' : ''),
+                'reference' => $paiement->reference,
+                'documents' => $paiement->allocations->map(fn (PaiementAllocation $allocation): ?string => $allocation->facture?->numero)->filter()->implode(', '),
+                'montant' => $euros($this->calculateur->enCentiemes($paiement->montant)),
+            ])->all(),
+        ])->render();
+    }
+
+    public function nomFichier(Magasin $magasin, string $mois): string
+    {
+        return "encaissements-{$magasin->code}-{$mois}.pdf";
+    }
+
+    /**
+     * Les encaissements de chaque mode qui en a, dans l'ordre de la caisse.
+     *
+     * @param  Collection<int, Paiement>  $paiements
+     * @param  callable(int): string  $euros
+     * @return list<array{libelle: string, paiements: int, contre_passations: int, montant: string}>
+     */
+    private function parMode(Collection $paiements, callable $euros): array
+    {
+        $modes = [];
+
+        foreach ([...ModePaiement::aLaCaisse(), ModePaiement::Prelevement] as $mode) {
+            $duMode = $paiements->filter(fn (Paiement $paiement): bool => $paiement->mode_paiement === $mode);
+
+            if ($duMode->isNotEmpty()) {
+                $modes[] = [
+                    'libelle' => $mode->getLabel(),
+                    'paiements' => $duMode->reject(fn (Paiement $paiement): bool => $paiement->estUneContrePassation())->count(),
+                    'contre_passations' => $duMode->filter(fn (Paiement $paiement): bool => $paiement->estUneContrePassation())->count(),
+                    'montant' => $euros($this->total($duMode)),
+                ];
+            }
+        }
+
+        return $modes;
+    }
+
+    /**
+     * @param  Collection<int, Paiement>  $paiements
+     */
+    private function total(Collection $paiements): int
+    {
+        return (int) $paiements->sum(fn (Paiement $paiement): int => $this->calculateur->enCentiemes($paiement->montant));
+    }
+}
diff --git a/app/Domain/Tenancy/Actions/DemanderLeTelechargementDesDocumentsAction.php b/app/Domain/Tenancy/Actions/DemanderLeTelechargementDesDocumentsAction.php
new file mode 100644
index 0000000..18c4f29
--- /dev/null
+++ b/app/Domain/Tenancy/Actions/DemanderLeTelechargementDesDocumentsAction.php
@@ -0,0 +1,130 @@
+<?php
+
+namespace App\Domain\Tenancy\Actions;
+
+use App\Domain\Calendrier\Calendrier;
+use App\Domain\Facturation\Enums\FormatDuTelechargement;
+use App\Domain\Facturation\Enums\OrigineDesAchats;
+use App\Domain\Facturation\Enums\TypeDeDocumentTelechargeable;
+use App\Domain\Facturation\Services\DocumentsDeLaPeriode;
+use App\Domain\Tenancy\Enums\StatutDuTelechargement;
+use App\Domain\Tenancy\Jobs\PreparerLeTelechargementDesDocumentsJob;
+use App\Domain\Tenancy\Models\Magasin;
+use App\Domain\Tenancy\Models\Societe;
+use App\Domain\Tenancy\Models\TelechargementDeDocuments;
+use App\Domain\Tenancy\Services\TenantContext;
+use App\Models\User;
+use Carbon\CarbonInterval;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+use LogicException;
+
+/**
+ * « Télécharger » sur la page « Télécharger les documents » d'un magasin,
+ * de l'espace de la société ou de l'espace du cabinet (décision de
+ * l'éditeur du 03/11/2026, lot EX) : enregistre la demande, dans la société
+ * dont elle lit les documents, et la confie à la file d'attente, qui
+ * prépare le fichier et prévient la personne quand il est prêt (voir
+ * PreparerLeTelechargementDesDocumentsJob).
+ *
+ * La demande désigne des magasins de cette société, chacun où la personne
+ * télécharge (voir DocumentsDeLaPeriode::peutTelechargerDans()) parmi ceux
+ * que la page propose ; une période d'un jour au moins, dans l'ordre ; au
+ * moins un type ; au moins un document choisi. Les documents choisis se
+ * relisent à la préparation, parmi ceux que la personne voit alors : une
+ * clé qui ne désigne rien n'apporte rien.
+ *
+ * Un compte demande au plus dix téléchargements par heure, toutes sociétés
+ * confondues : sous le verrou de la ligne du compte, ses demandes de
+ * l'heure se comptent, si bien que deux demandes simultanées ne dépassent
+ * jamais ce nombre. La société se verrouille d'abord, comme avant toute
+ * entrée de son journal d'audit (voir
+ * Societe::verrouillerAvantSonJournalDAudit()) : la demande, qui la
+ * référence, ne s'interbloque jamais avec la saisie du code du courrier,
+ * qui verrouille la société puis son propriétaire.
+ */
+class DemanderLeTelechargementDesDocumentsAction
+{
+    public const REFUS_PERIODE = 'Choisissez une période : son premier jour, puis son dernier, au plus tard le même.';
+
+    public const REFUS_TYPES = 'Choisissez au moins un type de document.';
+
+    public const REFUS_SELECTION = 'Choisissez au moins un document à télécharger.';
+
+    public const REFUS_MAGASINS = 'Vous ne téléchargez pas les documents de ce magasin.';
+
+    public const REFUS_PAR_HEURE = 'Vous avez déjà demandé dix téléchargements dans l\'heure : réessayez un peu plus tard.';
+
+    public function __construct(
+        private readonly TenantContext $contexte,
+        private readonly DocumentsDeLaPeriode $documents,
+    ) {}
+
+    /**
+     * @param  iterable<Magasin>  $magasins  les magasins de la société choisis, chacun déjà proposé à la personne
+     * @param  list<TypeDeDocumentTelechargeable>  $types
+     * @param  list<string>  $selection  les clés des documents choisis (voir DocumentTrouve::cle())
+     *
+     * @throws AuthorizationException
+     * @throws InvalidArgumentException
+     * @throws LogicException
+     */
+    public function handle(User $auteur, Societe $societe, iterable $magasins, string $du, string $au, array $types, OrigineDesAchats $origine, FormatDuTelechargement $format, array $selection): TelechargementDeDocuments
+    {
+        $magasins = collect($magasins)->values();
+
+        if (Calendrier::jourValide($du) === null || Calendrier::jourValide($au) === null || $du > $au) {
+            throw new InvalidArgumentException(self::REFUS_PERIODE);
+        }
+
+        if ($types === []) {
+            throw new InvalidArgumentException(self::REFUS_TYPES);
+        }
+
+        $selection = array_values(array_unique(array_filter($selection, 'is_string')));
+
+        if ($selection === []) {
+            throw new InvalidArgumentException(self::REFUS_SELECTION);
+        }
+
+        if ($magasins->isEmpty() || $magasins->contains(fn (Magasin $magasin): bool => (int) $magasin->societe_id !== (int) $societe->getKey())) {
+            throw new AuthorizationException(self::REFUS_MAGASINS);
+        }
+
+        $telechargement = DB::transaction(function () use ($auteur, $societe, $magasins, $du, $au, $types, $origine, $format, $selection): TelechargementDeDocuments {
+            Societe::verrouillerAvantSonJournalDAudit($societe->getKey());
+            $compte = User::query()->whereKey($auteur->getKey())->lock('for no key update')->firstOrFail();
+
+            if (! $compte->peutAgir() || $magasins->contains(fn (Magasin $magasin): bool => ! $this->documents->peutTelechargerDans($compte, $magasin))) {
+                throw new AuthorizationException(self::REFUS_MAGASINS);
+            }
+
+            if (TelechargementDeDocuments::demandesDepuis($compte, now()->subHour())->count() >= TelechargementDeDocuments::PAR_HEURE_AU_PLUS) {
+                throw new LogicException(self::REFUS_PAR_HEURE);
+            }
+
+            return $this->contexte->runAsSociete($societe, function () use ($compte, $magasins, $du, $au, $types, $origine, $format, $selection): TelechargementDeDocuments {
+                $telechargement = (new TelechargementDeDocuments)->forceFill([
+                    'demande_par' => $compte->getKey(),
+                    'magasins' => $magasins->map(fn (Magasin $magasin): int => (int) $magasin->getKey())->all(),
+                    'du' => $du,
+                    'au' => $au,
+                    'types' => array_map(fn (TypeDeDocumentTelechargeable $type): string => $type->value, $types),
+                    'origine' => $origine,
+                    'format' => $format,
+                    'selection' => $selection,
+                    'statut' => StatutDuTelechargement::EnPreparation,
+                    'expire_le' => Calendrier::deParis()->decaler(now(), CarbonInterval::days(TelechargementDeDocuments::JOURS_DE_VALIDITE)),
+                ]);
+                $telechargement->save();
+
+                return $telechargement;
+            });
+        });
+
+        PreparerLeTelechargementDesDocumentsJob::dispatch($telechargement->getKey());
+
+        return $telechargement;
+    }
+}
