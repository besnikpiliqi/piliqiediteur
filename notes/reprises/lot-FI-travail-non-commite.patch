+        $pdf .= "{$numeroDeLaTable} 0 obj\n<< /Type /XRef /Size ".($numeroDeLaTable + 1)." /W [1 4 2] /Index [{$index}] /Root {$racine} /Prev {$precedente} /Length ".strlen($entrees)." >>\nstream\n{$entrees}\nendstream\nendobj\n";
