@@ -0,0 +1,34 @@
+<?php
+
+namespace App\Integrations\Antivirus\Contracts;
+
+use App\Integrations\Antivirus\AntivirusInjoignableException;
+use App\Integrations\Antivirus\ResultatDeLAntivirus;
+
+/**
+ * L'antivirus qui analyse chaque fichier reçu (décision de l'éditeur du
+ * 07/11/2026, lot FI, voir ControleDesFichiers), au dépôt et de nouveau au
+ * téléchargement quand sa dernière analyse a plus de 24 heures (voir
+ * RevueAntivirus) : ClamAV sur le serveur (voir ClamAv, pilote « clamav »),
+ * ou une implémentation factice qui ne reconnaît que le fichier de test
+ * EICAR (voir AntivirusFactice, pilote « factice »), pour les tests, la
+ * démonstration et le développement, qui fait échouer caisse:diagnostiquer
+ * en production (voir AntivirusServiceProvider). Il ne reçoit que le
+ * contenu, jamais un nom ni un chemin.
+ */
+interface Antivirus
+{
+    /**
+     * Le verdict de l'antivirus sur ce contenu.
+     *
+     * @throws AntivirusInjoignableException quand il ne répond pas, ou ne sait pas l'analyser
+     */
+    public function analyser(string $contenu): ResultatDeLAntivirus;
+
+    /**
+     * Ce qu'est cet antivirus, pour le diagnostic du serveur : sa version.
+     *
+     * @throws AntivirusInjoignableException quand il ne répond pas
+     */
+    public function description(): string;
+}
diff --git a/app/Integrations/Antivirus/ResultatDeLAntivirus.php b/app/Integrations/Antivirus/ResultatDeLAntivirus.php
new file mode 100644
index 0000000..0a32f73
--- /dev/null
+++ b/app/Integrations/Antivirus/ResultatDeLAntivirus.php
@@ -0,0 +1,27 @@
+<?php
+
+namespace App\Integrations\Antivirus;
+
+/**
+ * Le verdict de l'antivirus sur un contenu : sain, ou la menace qu'il y a
+ * trouvée, sous le nom que lui donne l'antivirus.
+ */
+final readonly class ResultatDeLAntivirus
+{
+    private function __construct(public ?string $menace) {}
+
+    public static function sain(): self
+    {
+        return new self(null);
+    }
+
+    public static function menace(string $nom): self
+    {
+        return new self($nom);
+    }
+
+    public function estSain(): bool
+    {
+        return $this->menace === null;
+    }
+}
diff --git a/app/Providers/AntivirusServiceProvider.php b/app/Providers/AntivirusServiceProvider.php
new file mode 100644
index 0000000..fd31ea0
--- /dev/null
+++ b/app/Providers/AntivirusServiceProvider.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Providers;
+
+use App\Domain\Tenancy\Support\Reglage;
+use App\Domain\Tenancy\Support\ValeurSimple;
+use App\Integrations\Antivirus\AntivirusFactice;
+use App\Integrations\Antivirus\ClamAv;
+use App\Integrations\Antivirus\Contracts\Antivirus;
+use Illuminate\Support\ServiceProvider;
+use RuntimeException;
+
+/**
+ * Le câblage de l'antivirus des fichiers reçus (décision de l'éditeur du
+ * 07/11/2026, lot FI), selon son pilote (ANTIVIRUS_PILOTE,
+ * config/services.php) : « clamav », le démon clamd du serveur, joint par
+ * sa socket (CLAMAV_SOCKET) ou, à défaut, par son hôte et son port
+ * (CLAMAV_HOTE, CLAMAV_PORT), en CLAMAV_DELAI secondes au plus ; ou
+ * « factice », pour les tests, la démonstration et le développement, sans
+ * aucune requête, que caisse:diagnostiquer refuse en production (voir
+ * pilote()).
+ */
+class AntivirusServiceProvider extends ServiceProvider
+{
+    public const CLAMAV = 'clamav';
+
+    public const FACTICE = 'factice';
+
+    public function register(): void
+    {
+        $this->app->singleton(Antivirus::class, fn (): Antivirus => match (self::pilote()) {
+            self::CLAMAV => new ClamAv(self::adresseDeClamd(), Reglage::entier('services.antivirus.clamav.delai')),
+            self::FACTICE => new AntivirusFactice,
+        });
+    }
+
+    /**
+     * Le pilote configuré.
+     *
+     * @throws RuntimeException quand ce pilote n'existe pas
+     */
+    public static function pilote(): string
+    {
+        $pilote = config('services.antivirus.pilote');
+
+        return in_array($pilote, [self::CLAMAV, self::FACTICE], true)
+            ? $pilote
+            : throw new RuntimeException('Pilote inconnu pour l\'antivirus : « '.ValeurSimple::enTexte($pilote).' » ('.self::CLAMAV.' ou '.self::FACTICE.').');
+    }
+
+    /**
+     * L'adresse de clamd : sa socket Unix si elle est configurée, sinon son
+     * hôte et son port.
+     */
+    private static function adresseDeClamd(): string
+    {
+        $socket = Reglage::texteOuNul('services.antivirus.clamav.socket');
+
+        return $socket !== null && $socket !== ''
+            ? 'unix://'.$socket
+            : 'tcp://'.Reglage::texte('services.antivirus.clamav.hote').':'.Reglage::entier('services.antivirus.clamav.port');
+    }
+}
