+
+    /**
+     * L'orientation de l'appareil s'applique aux pixels, puisque l'EXIF ne
+     * reste pas : le coin rouge, en haut à gauche de l'image enregistrée,
+     * finit où l'appareil l'a vu.
+     */
+    public function test_l_orientation_de_l_appareil_est_appliquee(): void
+    {
+        $attendus = [
+            1 => [40, 30, [0, 0]],
+            2 => [40, 30, [39, 0]],
+            3 => [40, 30, [39, 29]],
+            4 => [40, 30, [0, 29]],
+            5 => [30, 40, [0, 0]],
+            6 => [30, 40, [29, 0]],
+            7 => [30, 40, [29, 39]],
+            8 => [30, 40, [0, 39]],
+        ];
+
+        foreach ($attendus as $orientation => [$largeur, $hauteur, [$x, $y]]) {
+            $photo = $this->controler('photo.jpg', FichiersDeTest::avecExif(FichiersDeTest::jpeg(), $orientation))->contenu;
+
+            $this->assertSame([$largeur, $hauteur], array_slice((array) getimagesizefromstring($photo), 0, 2), "Orientation {$orientation}");
+            $this->assertSame('rouge', FichiersDeTest::couleur($photo, $x, $y), "Orientation {$orientation}");
+        }
+    }
+
+    /**
+     * Les dimensions se lisent dans l'en-tête avant tout décodage : une
+     * image démesurée est refusée sans être décodée ; une image qui ne se
+     * décode pas est refusée.
+     */
+    public function test_une_image_demesuree_ou_illisible_est_refusee(): void
+    {
+        $this->assertSame(RaisonDuRefus::ImageTropGrande, $this->refus('bombe.png', FichiersDeTest::enTetePng(100000, 100000))->raison);
+        $this->assertSame(RaisonDuRefus::ImageTropGrande, $this->refus('bande.png', FichiersDeTest::enTetePng(20000, 2))->raison);
+        $this->assertSame(RaisonDuRefus::ImageIllisible, $this->refus('vide.png', FichiersDeTest::enTetePng(10, 10))->raison);
+        $this->assertSame(RaisonDuRefus::ImageIllisible, $this->refus('photo.jpg', "\xFF\xD8\xFF\xE0\x00\x10JFIF\x00 pas une photo")->raison);
+        $this->assertSame(RaisonDuRefus::ImageIllisible, $this->refus('abimee.png', substr_replace(FichiersDeTest::png(), str_repeat("\x00", 20), 45, 20))->raison);
+    }
+
+    /**
+     * Le type se lit dans le contenu, jamais dans le nom ; un fichier vide
+     * ou de plus de 10 Mo est refusé avant toute lecture.
+     */
+    public function test_un_autre_type_un_fichier_vide_ou_trop_gros_est_refuse(): void
+    {
+        $this->assertSame(RaisonDuRefus::Type, $this->refus('facture.pdf', "MZ\x90\x00 un programme")->raison);
+        $this->assertSame(RaisonDuRefus::Type, $this->refus('page.html', '<html><body>%PDF-</body></html>')->raison);
+        $this->assertSame(RaisonDuRefus::Vide, $this->refus('vide.pdf', '')->raison);
+        $this->assertSame(RaisonDuRefus::TropGros, $this->refus('gros.pdf', str_repeat('x', ControleDesFichiers::TAILLE_MAXIMALE_EN_OCTETS + 1))->raison);
+        $this->assertFalse(RaisonDuRefus::Vide->estDeSecurite());
+        $this->assertTrue(RaisonDuRefus::Type->estDeSecurite());
+    }
+
+    /**
+     * L'antivirus analyse le fichier tel que reçu, avant toute lecture :
+     * le fichier de test EICAR est refusé par l'antivirus factice, même
+     * nommé en PDF ; un antivirus injoignable refuse le dépôt, jamais
+     * accepté sans analyse.
+     */
+    public function test_l_antivirus_refuse_une_menace_et_un_antivirus_injoignable_refuse_le_depot(): void
+    {
+        $menace = $this->refus('facture.pdf', AntivirusFactice::fichierDeTest());
+        $this->assertSame([RaisonDuRefus::Menace, AntivirusFactice::MENACE], [$menace->raison, $menace->menace]);
+        $eicar = AntivirusFactice::fichierDeTest();
+        $this->assertSame(RaisonDuRefus::Menace, $this->refus('facture.pdf', FichiersDeTest::pdf('x', '', ['<< /Length '.strlen($eicar)." >>\nstream\n{$eicar}\nendstream"]))->raison);
+
+        $this->app->instance(Antivirus::class, new class implements Antivirus
+        {
+            public function analyser(string $contenu): ResultatDeLAntivirus
+            {
+                throw new AntivirusInjoignableException('clamd est injoignable.');
+            }
+
+            public function description(): string
+            {
+                throw new AntivirusInjoignableException('clamd est injoignable.');
+            }
+        });
+
+        $injoignable = $this->refus('facture.pdf', FichiersDeTest::pdf());
+        $this->assertSame(RaisonDuRefus::AntivirusInjoignable, $injoignable->raison);
+        $this->assertFalse($injoignable->raison->estDeSecurite());
+        $this->assertStringContainsString('réessayez dans quelques minutes', $injoignable->getMessage());
+    }
+
+    /**
+     * Demandé par l'API, le refus est une erreur 422 qui dit sa raison ;
+     * ailleurs, l'écran le montre.
+     */
+    public function test_l_api_recoit_une_erreur_422_qui_dit_la_raison(): void
+    {
+        $refus = $this->refus('facture.bat', FichiersDeTest::pdf('x', '/OpenAction << /S /Launch /F (calc.exe) >>'));
+
+        $reponse = $refus->render(Request::create('/api/factures-achat', 'POST', server: ['HTTP_ACCEPT' => 'application/json']));
+
+        $this->assertSame(422, $reponse?->getStatusCode());
+        $this->assertSame(['message' => $refus->getMessage(), 'raison' => 'pdf_actif'], $reponse->getData(true));
+        $this->assertStringContainsString('le lancement d\'un programme et une action automatique à l\'ouverture', $refus->getMessage());
+        $this->assertNull($refus->render(Request::create('/app')));
+    }
+
+    private function controler(string $nom, string $contenu): FichierControle
+    {
+        return app(ControleDesFichiers::class)->controler(new PieceDeposee($nom, $contenu));
+    }
+
+    private function refus(string $nom, string $contenu): FichierRefuseException
+    {
+        try {
+            $this->controler($nom, $contenu);
+        } catch (FichierRefuseException $refus) {
+            $this->assertSame([$nom, hash('sha256', $contenu), strlen($contenu)], [$refus->nomRecu, $refus->empreinteRecue, $refus->tailleRecue]);
+
+            return $refus;
+        }
+
+        $this->fail("Le fichier « {$nom} » devait être refusé.");
+    }
+
+    /**
+     * Un PDF qui porte ce XML comme seul fichier joint, sous ce nom et ce
+     * type.
+     */
+    private function facturX(string $xml, string $nom = 'factur-x.xml', string $type = 'text#2Fxml'): string
+    {
+        return FichiersDeTest::pdf('Facture FA-812', "/Names << /EmbeddedFiles << /Names [({$nom}) 5 0 R] >> >> /AF [5 0 R]", [
+            "<< /Type /Filespec /F ({$nom}) /UF ({$nom}) /AFRelationship /Data /EF << /F 6 0 R /UF 6 0 R >> >>",
+            FichiersDeTest::fluxCompresse($xml, "/Type /EmbeddedFile /Subtype /{$type}"),
+        ]);
+    }
+}
diff --git a/tests/Feature/Fichiers/EnvoisTemporairesTest.php b/tests/Feature/Fichiers/EnvoisTemporairesTest.php
new file mode 100644
index 0000000..5d77ab4
--- /dev/null
+++ b/tests/Feature/Fichiers/EnvoisTemporairesTest.php
@@ -0,0 +1,127 @@
+<?php
+
+namespace Tests\Feature\Fichiers;
+
+use App\Domain\Tenancy\Enums\RoleMagasin;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Route;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Testing\TestResponse;
+use Livewire\Features\SupportFileUploads\FileNotPreviewableException;
+use Livewire\Features\SupportFileUploads\FileUploadConfiguration;
+use Livewire\Features\SupportFileUploads\GenerateSignedUploadUrl;
+use Livewire\Features\SupportFileUploads\TemporaryUploadedFile;
+use Symfony\Component\HttpFoundation\Response;
+use Tests\Fixtures\FichiersDeTest;
+use Tests\TestCase;
+
+/**
+ * Les envois temporaires de Livewire, où part d'abord un fichier choisi
+ * dans un formulaire (pièce du fournisseur, pièce de la vérification de la
+ * société), avant que l'action qui le dépose le contrôle en entier
+ * (décision de l'éditeur du 07/11/2026, lot FI) : sur le disque privé,
+ * jamais servi par une adresse ; refusés par le serveur, quoi que le
+ * navigateur ait laissé passer, s'ils ne sont ni un PDF ni une photo JPEG
+ * ou PNG, le type étant lu dans leur contenu ; leur aperçu n'est servi que
+ * pour une photo.
+ */
+class EnvoisTemporairesTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_les_envois_temporaires_restent_sur_le_disque_prive_jamais_servi(): void
+    {
+        $this->assertSame('local', config('livewire.temporary_file_upload.disk'));
+        $this->assertSame([storage_path('app/private'), false], [config('filesystems.disks.local.root'), config('filesystems.disks.local.serve')]);
+        $this->assertFalse(Route::has('storage.local'), 'Aucune adresse ne sert le disque privé.');
+        $this->assertFalse(Route::has('storage.local.upload'), 'Aucune adresse n\'écrit sur le disque privé.');
+    }
+
+    /**
+     * Une page HTML, une image SVG ou un programme sont refusés par le
+     * serveur à l'envoi temporaire, même sous un nom en .pdf ou en .png ;
+     * rien n'est rangé. Un PDF et des photos JPEG et PNG passent.
+     */
+    public function test_le_serveur_refuse_un_envoi_qui_n_est_ni_un_pdf_ni_une_photo(): void
+    {
+        Storage::fake(FileUploadConfiguration::disk());
+        $this->actingAs($this->membre($this->ouvrirUneSociete(), RoleMagasin::Responsable));
+
+        foreach ([
+            'facture.pdf' => '<!DOCTYPE html><html><body><script>alert(1)</script></body></html>',
+            'photo.png' => '<svg xmlns="http://www.w3.org/2000/svg" onload="alert(1)"><circle r="1"/></svg>',
+            'facture.pdf.exe' => "MZ\x90\x00\x03\x00\x00\x00\x04\x00\x00\x00\xFF\xFF\x00\x00",
+        ] as $nom => $contenu) {
+            $this->envoyer([$this->fichier($nom, $contenu)])
+                ->assertUnprocessable()
+                ->assertJsonValidationErrors(['files.0']);
+        }
+
+        $this->assertSame([], Storage::disk(FileUploadConfiguration::disk())->allFiles());
+
+        $this->envoyer([
+            $this->fichier('facture.pdf', FichiersDeTest::pdf()),
+            $this->fichier('photo.jpg', FichiersDeTest::jpeg()),
+            $this->fichier('photo.png', FichiersDeTest::png()),
+        ])->assertOk()->assertJsonCount(3, 'paths');
+    }
+
+    public function test_le_serveur_refuse_un_envoi_de_plus_de_10_mo(): void
+    {
+        Storage::fake(FileUploadConfiguration::disk());
+        $this->actingAs($this->membre($this->ouvrirUneSociete(), RoleMagasin::Responsable));
+
+        $this->envoyer([$this->fichier('facture.pdf', FichiersDeTest::pdfDeTaille(10 * 1024 * 1024 + 1024))])
+            ->assertUnprocessable()
+            ->assertJsonValidationErrors(['files.0']);
+    }
+
+    /**
+     * L'aperçu d'un envoi temporaire n'est servi que pour une photo JPEG
+     * ou PNG : jamais pour un PDF.
+     */
+    public function test_l_apercu_n_est_servi_que_pour_une_photo(): void
+    {
+        $disque = Storage::fake(FileUploadConfiguration::disk());
+        $disque->put(FileUploadConfiguration::path('facture.pdf'), FichiersDeTest::pdf());
+        $disque->put(FileUploadConfiguration::path('photo.png'), FichiersDeTest::png());
+        $disque->put(FileUploadConfiguration::path('photo.jpg'), FichiersDeTest::jpeg());
+
+        $pdf = new TemporaryUploadedFile('facture.pdf', FileUploadConfiguration::disk());
+
+        $this->assertSame([false, true, true], [
+            $pdf->isPreviewable(),
+            (new TemporaryUploadedFile('photo.png', FileUploadConfiguration::disk()))->isPreviewable(),
+            (new TemporaryUploadedFile('photo.jpg', FileUploadConfiguration::disk()))->isPreviewable(),
+        ]);
+        $this->expectException(FileNotPreviewableException::class);
+        $pdf->temporaryUrl();
+    }
+
+    /**
+     * Un fichier envoyé de ce nom et de ce contenu, dont le serveur lit le
+     * type dans le contenu, comme celui d'un navigateur (un faux fichier
+     * des tests le déduirait de son nom).
+     */
+    private function fichier(string $nom, string $contenu): UploadedFile
+    {
+        $chemin = (string) tempnam(sys_get_temp_dir(), 'envoi-');
+        file_put_contents($chemin, $contenu);
+        $this->beforeApplicationDestroyed(fn () => @unlink($chemin));
+
+        return new UploadedFile($chemin, $nom, null, null, true);
+    }
+
+    /**
+     * L'envoi de ces fichiers à l'adresse signée que Livewire donne au
+     * navigateur.
+     *
+     * @param  list<UploadedFile>  $fichiers
+     * @return TestResponse<Response>
+     */
+    private function envoyer(array $fichiers): TestResponse
+    {
+        return $this->post(app(GenerateSignedUploadUrl::class)->forLocal(), ['files' => $fichiers], ['Accept' => 'application/json']);
+    }
+}
diff --git a/tests/Feature/Fichiers/PdfDePiliqiTest.php b/tests/Feature/Fichiers/PdfDePiliqiTest.php
new file mode 100644
index 0000000..68016bd
--- /dev/null
+++ b/tests/Feature/Fichiers/PdfDePiliqiTest.php
@@ -0,0 +1,106 @@
+<?php
+
+namespace Tests\Feature\Fichiers;
+
+use App\Domain\Catalogue\Models\Produit;
+use App\Domain\Contacts\Models\Client;
+use App\Domain\Facturation\Actions\CreerDevisAction;
+use App\Domain\Facturation\Actions\EmettreDevisAction;
+use App\Domain\Facturation\Models\Devis;
+use App\Domain\Facturation\Services\DevisPdfGenerator;
+use App\Domain\Fichiers\AnalyseurDePdf;
+use App\Domain\Fichiers\EnTetesDesFichiers;
+use App\Domain\Fichiers\PieceDeposee;
+use App\Domain\Tenancy\Enums\FormeJuridique;
+use App\Domain\Tenancy\Models\Magasin;
+use App\Domain\Tenancy\Services\TenantContext;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\File;
+use Tests\Fixtures\FichiersDeTest;
+use Tests\TestCase;
+
+/**
+ * Les PDF que PILIQI produit lui-même (décision de l'éditeur du
+ * 07/11/2026, lot FI) : dompdf n'y exécute ni JavaScript ni PHP, n'y
+ * charge rien d'extérieur ni de local hors de ses polices ; un nom de
+ * client ou une désignation qui contiendrait du code reste du texte ; et
+ * l'analyseur des PDF reçus n'y trouve ni JavaScript ni action
+ * automatique.
+ */
+class PdfDePiliqiTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_dompdf_n_execute_rien_et_ne_lit_que_ses_polices(): void
+    {
+        $options = config('dompdf.options');
+
+        $this->assertSame([false, false, false], [$options['enable_javascript'], $options['enable_php'], $options['enable_remote']]);
+        $this->assertSame([storage_path('fonts'), base_path('vendor/dompdf/dompdf/lib/fonts')], $options['chroot']);
+        $this->assertSame(['data://', 'file://'], array_keys($options['allowed_protocols']));
+    }
+
+    /**
+     * Un fichier que PILIQI produit lui-même (PDF d'un document, reçu,
+     * export du journal des événements) garde son mode d'affichage, avec
+     * son type exact, sans que le navigateur en devine un autre ni le
+     * garde en cache ; seul un fichier reçu, ou qui en contient, part
+     * toujours en pièce jointe, dans un bac à sable.
+     */
+    public function test_un_fichier_produit_part_avec_son_type_exact_sans_cache(): void
+    {
+        $this->assertSame(
+            ['Content-Type' => 'application/pdf', 'X-Content-Type-Options' => 'nosniff', 'Cache-Control' => 'private, no-store'],
+            EnTetesDesFichiers::fichierProduit('application/pdf'),
+        );
+        $this->assertSame(
+            ['Content-Type', 'Content-Disposition', 'X-Content-Type-Options', 'Content-Security-Policy', 'Cache-Control', 'Cross-Origin-Resource-Policy'],
+            array_keys(EnTetesDesFichiers::fichierRecu('facture.pdf', 'application/pdf')),
+        );
+    }
+
+    /**
+     * Un nom de client et une désignation qui contiennent du code
+     * s'impriment tels quels, comme du texte ; l'image locale qu'ils
+     * désignent n'est pas lue, et le PDF ne contient ni JavaScript ni
+     * action automatique.
+     */
+    public function test_un_texte_dangereux_dans_un_document_reste_du_texte(): void
+    {
+        $image = storage_path('framework/testing/image-secrete.png');
+        File::ensureDirectoryExists(dirname($image));
+        File::put($image, FichiersDeTest::png());
+        $client = '<script>app.alert(1)</script><img src="file://'.$image.'">';
+        $designation = '<link rel="stylesheet" href="file://'.base_path('.env').'"><span style="background:url(file://'.$image.')">Écran</span>';
+
+        try {
+            $pdf = app(DevisPdfGenerator::class)->generer($this->devisEnvoye($client, $designation))->output();
+        } finally {
+            File::delete($image);
+        }
+
+        $texte = implode(' ', array_merge(...array_map(fn (array $page): array => array_column($page['textes'], 'texte'), $this->pagesDuPdf($pdf))));
+        $this->assertStringContainsString('<script>app.alert(1)</script>', $texte);
+        $this->assertStringContainsString('<link rel="stylesheet"', $texte);
+        $this->assertStringNotContainsString('/Subtype /Image', $pdf, 'Aucune image n\'est chargée.');
+        $this->assertStringNotContainsString('APP_KEY', $pdf);
+        app(AnalyseurDePdf::class)->analyser(new PieceDeposee('devis.pdf', $pdf));
+    }
+
+    private function devisEnvoye(string $client, string $designation): Devis
+    {
+        $this->travelTo(self::aParis('2026-10-09 10:00:00'));
+        app(TenantContext::class)->set(Magasin::factory()->avecLaSociete([
+            'raison_sociale' => 'Martin et Fils',
+            'forme_juridique' => FormeJuridique::Sarl,
+            'siren' => '121212120',
+            'numero_tva' => 'FR56121212120',
+        ])->create(['nom' => 'Boutique du Port', 'siret' => '12121212000020']));
+        $produit = Produit::factory()->create(['nom' => $designation, 'prix_vente_ttc' => 120, 'taux_tva' => 20]);
+        $devis = app(CreerDevisAction::class)->handle(self::auteur(), Client::factory()->professionnel()->create(['nom' => $client]), [
+            ['produit_id' => $produit->id, 'quantite' => 1],
+        ], ['date_validite' => '2026-12-31']);
+
+        return app(EmettreDevisAction::class)->handle(self::auteur(), $devis);
+    }
+}
diff --git a/tests/Feature/Fichiers/PiecesDeVerificationTest.php b/tests/Feature/Fichiers/PiecesDeVerificationTest.php
new file mode 100644
index 0000000..8727323
--- /dev/null
+++ b/tests/Feature/Fichiers/PiecesDeVerificationTest.php
@@ -0,0 +1,313 @@
+<?php
+
+namespace Tests\Feature\Fichiers;
+
+use App\Domain\Fichiers\Enums\RaisonDuRefus;
+use App\Domain\Fichiers\Exceptions\FichierRefuseException;
+use App\Domain\Fichiers\PieceDeposee;
+use App\Domain\Tenancy\Actions\DeposerUnePieceAction;
+use App\Domain\Tenancy\Actions\EnvoyerCodeDeConfirmationAction;
+use App\Domain\Tenancy\Enums\ActionAuditee;
+use App\Domain\Tenancy\Enums\TypePiece;
+use App\Domain\Tenancy\Models\PieceVerification;
+use App\Domain\Tenancy\Models\Societe;
+use App\Domain\Tenancy\Notifications\AvisDeLAntivirus;
+use App\Domain\Tenancy\Services\PiecesDeVerification;
+use App\Domain\Tenancy\Services\TenantContext;
+use App\Integrations\Antivirus\AntivirusFactice;
+use App\Integrations\Antivirus\AntivirusInjoignableException;
+use App\Integrations\Antivirus\Contracts\Antivirus;
+use App\Integrations\Antivirus\ResultatDeLAntivirus;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\File;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Testing\PendingCommand;
+use Tests\Fixtures\FichiersDeTest;
+use Tests\TestCase;
+
+/**
+ * Les pièces déposées pour l'éditeur par une société dont les courriers
+ * ne sont pas parvenus, face aux contrôles des fichiers reçus (décisions de
+ * l'éditeur du 07/11/2026, lot FI) : un refus pour une raison de sécurité
+ * s'inscrit au journal d'audit de la société, une menace prévient le
+ * propriétaire ; à la consultation par l'éditeur (editeur:societe:pieces),
+ * une pièce dont la dernière analyse a plus de 24 heures repasse par
+ * l'antivirus, et une menace trouvée alors la bloque, gardée mais jamais
+ * déchiffrée dans le dossier d'examen ; chaque pièce y porte l'extension
+ * de son type réel ; un antivirus injoignable arrête l'examen.
+ */
+class PiecesDeVerificationTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private Societe $societe;
+
+    private User $proprietaire;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        Storage::fake(PiecesDeVerification::DISQUE);
+        Notification::fake();
+        config(['editeur.operateurs' => ['alice' => password_hash('secret-d-alice', PASSWORD_ARGON2ID, ['memory_cost' => 1024, 'time_cost' => 1, 'threads' => 1])]]);
+        $this->societe = $this->societeDontLesCourriersNeSontPasParvenus();
+        $this->proprietaire = $this->societe->proprietaire()->sole();
+    }
+
+    /**
+     * Un PDF actif, puis le fichier de test EICAR, refusés : rien n'est
+     * enregistré ni rangé, chaque refus s'inscrit au journal d'audit de la
+     * société (type de la pièce, raison, ce qu'il contient, nom tel que
+     * reçu, empreinte et taille du fichier reçu, jamais son contenu), et
+     * seule la menace prévient le propriétaire.
+     */
+    public function test_un_refus_de_securite_s_inscrit_au_journal_d_audit_sans_rien_enregistrer(): void
+    {
+        $actif = FichiersDeTest::pdf('Extrait Kbis', '/OpenAction << /S /JavaScript /JS (app.alert\\(1\\)) >>');
+        $eicar = AntivirusFactice::fichierDeTest();
+
+        $this->assertRefus(RaisonDuRefus::PdfActif, fn () => $this->deposer(TypePiece::Kbis, new PieceDeposee('kbis.pdf', $actif)));
+        $this->assertRefus(RaisonDuRefus::Menace, fn () => $this->deposer(TypePiece::Identite, new PieceDeposee("carte\u{202E}gpj.exe", $eicar)));
+        $this->assertRefus(RaisonDuRefus::Vide, fn () => $this->deposer(TypePiece::Autre, new PieceDeposee('vide.pdf', '')));
+
+        $this->assertSame(0, app(TenantContext::class)->runAsSociete($this->societe, fn (): int => PieceVerification::query()->count()));
+        $this->assertSame([], Storage::disk(PiecesDeVerification::DISQUE)->allFiles());
+        $this->assertSame([
+            [
+                'detail' => ['javascript', 'action_automatique'],
+                'empreinte_recue' => hash('sha256', $actif),
+                'nom_recu' => 'kbis.pdf',
