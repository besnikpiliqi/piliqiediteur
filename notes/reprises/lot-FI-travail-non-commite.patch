@@ -169,6 +169,25 @@ RECOMMANDE_SECRET_RAPPEL=
 # php artisan editeur:cabinet:verifier-ordre.
 ORDRE_PILOTE=faux
 
+# Contrôle des fichiers reçus (pièces du fournisseur, pièces de la
+# vérification de la société, voir ControleDesFichiers).
+# qpdf lit en entier chaque PDF reçu : « qpdf » s'il est dans le PATH,
+# sinon son chemin complet (sous Windows, par exemple
+# C:\qpdf\bin\qpdf.exe). Sans lui, tout PDF reçu est refusé.
+QPDF_BINAIRE=qpdf
+# Antivirus : « factice » en développement et pour les tests, qui ne
+# reconnaît que le fichier de test EICAR, sans aucune requête (voir
+# AntivirusFactice) ; « clamav » en production, le démon clamd du serveur,
+# joint par sa socket Unix (CLAMAV_SOCKET, par exemple
+# /var/run/clamav/clamd.ctl) ou, si elle est vide, par son hôte et son port.
+# caisse:diagnostiquer échoue en production avec l'antivirus factice.
+# Aucun secret.
+ANTIVIRUS_PILOTE=factice
+CLAMAV_SOCKET=
+CLAMAV_HOTE=127.0.0.1
+CLAMAV_PORT=3310
+CLAMAV_DELAI=30
+
 # Au plus ce nombre d'invitations et de demandes de rattachement envoyées
 # par jour et par cabinet d'expertise comptable (voir config/cabinets.php).
 CABINET_INVITATIONS_PAR_JOUR=50
