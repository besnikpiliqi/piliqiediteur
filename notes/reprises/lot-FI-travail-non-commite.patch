+        foreach ($objets as $numero => $objet) {
+            $positions[$numero] = strlen($pdf);
+            $pdf .= "{$numero} 0 obj\n{$objet}\nendobj\n";
+        }
+
+        $numeroDeLaTable = max($taille, max(array_keys($objets)) + 1);
