+<?php
+
+namespace App\Domain\Fichiers\Enums;
+
+/**
+ * Ce qu'un PDF reçu ne peut pas contenir (décision de l'éditeur du
+ * 07/11/2026, Q-FI1 = a, voir AnalyseurDePdf) : chaque contenu est une
+ * raison de refuser le fichier, que le message nomme.
+ */
+enum ContenuActif: string
+{
+    /** /JavaScript, /JS. */
+    case JavaScript = 'javascript';
+
+    /** /Launch. */
+    case LancementDeProgramme = 'lancement_de_programme';
+
+    /** /SubmitForm, /ImportData. */
+    case EnvoiDeFormulaire = 'envoi_de_formulaire';
+
+    /** /RichMedia, et les actions et annotations de son, de film ou d'écran. */
+    case ContenuMultimedia = 'contenu_multimedia';
+
+    /** /XFA. */
+    case FormulaireDynamique = 'formulaire_dynamique';
+
+    /** /GoToR, /GoToE. */
+    case LienVersUnAutreFichier = 'lien_vers_un_autre_fichier';
+
+    /** /OpenAction ou /AA autre qu'une simple destination d'affichage. */
+    case ActionAutomatique = 'action_automatique';
+
+    /** /EmbeddedFile(s), /FileAttachment, autre qu'un seul XML de Factur-X. */
+    case FichierJoint = 'fichier_joint';
+
+    public function libelle(): string
+    {
+        return match ($this) {
+            self::JavaScript => 'du JavaScript',
+            self::LancementDeProgramme => 'le lancement d\'un programme',
+            self::EnvoiDeFormulaire => 'un formulaire qui envoie ou importe des données',
+            self::ContenuMultimedia => 'un contenu multimédia',
+            self::FormulaireDynamique => 'un formulaire dynamique (XFA)',
+            self::LienVersUnAutreFichier => 'un lien qui ouvre un autre fichier',
+            self::ActionAutomatique => 'une action automatique à l\'ouverture',
+            self::FichierJoint => 'un fichier joint',
+        };
+    }
+}
diff --git a/app/Domain/Fichiers/Enums/RaisonDuRefus.php b/app/Domain/Fichiers/Enums/RaisonDuRefus.php
new file mode 100644
index 0000000..9d5894e
--- /dev/null
+++ b/app/Domain/Fichiers/Enums/RaisonDuRefus.php
@@ -0,0 +1,73 @@
+<?php
+
+namespace App\Domain\Fichiers\Enums;
+
+/**
+ * Pourquoi un fichier reçu est refusé (voir ControleDesFichiers). Un refus
+ * pour une raison de sécurité s'inscrit au journal d'audit de la société
+ * (décision de l'éditeur du 07/11/2026, lot FI) ; un fichier vide ou trop
+ * gros, ou un antivirus ou un analyseur qui ne répond pas, non : le
+ * fichier n'a rien montré de dangereux.
+ */
+enum RaisonDuRefus: string
+{
+    case Vide = 'vide';
+    case TropGros = 'trop_gros';
+    case Type = 'type';
+    case PdfActif = 'pdf_actif';
+    case PdfIllisible = 'pdf_illisible';
+    case PdfProtege = 'pdf_protege';
+    case ImageIllisible = 'image_illisible';
+    case ImageTropGrande = 'image_trop_grande';
+    case Menace = 'menace';
+    case AntivirusInjoignable = 'antivirus_injoignable';
+    case AnalyseIndisponible = 'analyse_indisponible';
+
+    /**
+     * Comment obtenir une copie propre d'un PDF refusé.
+     */
+    public const COPIE_PROPRE = 'Pour joindre une copie propre, demandez à son expéditeur un PDF sans code, imprimez le document en PDF (« Imprimer », puis « Enregistrer au format PDF ») ou photographiez-le.';
+
+    public function estDeSecurite(): bool
+    {
+        return match ($this) {
+            self::Type, self::PdfActif, self::PdfIllisible, self::PdfProtege, self::ImageIllisible, self::ImageTropGrande, self::Menace => true,
+            self::Vide, self::TropGros, self::AntivirusInjoignable, self::AnalyseIndisponible => false,
+        };
+    }
+
+    /**
+     * Le message qui dit pourquoi le fichier de ce nom est refusé, et quoi
+     * faire.
+     *
+     * @param  list<ContenuActif>  $contenus  ce que contient un PDF refusé pour son code actif
+     */
+    public function message(string $nom, array $contenus = []): string
+    {
+        return match ($this) {
+            self::Vide => "Le fichier « {$nom} » est vide.",
+            self::TropGros => "Le fichier « {$nom} » dépasse 10 Mo : une pièce fait 10 Mo au plus.",
+            self::Type => "Le fichier « {$nom} » n'est ni un PDF, ni une photo JPEG ou PNG.",
+            self::PdfActif => "Le fichier « {$nom} » est refusé : ce PDF contient ".self::enumerer(array_map(fn (ContenuActif $contenu): string => $contenu->libelle(), $contenus)).'. '.self::COPIE_PROPRE,
+            self::PdfIllisible => "Le fichier « {$nom} » est refusé : ce PDF ne se lit pas en entier (abîmé, incomplet ou suivi d'un autre contenu). ".self::COPIE_PROPRE,
+            self::PdfProtege => "Le fichier « {$nom} » est refusé : ce PDF est protégé par un mot de passe d'ouverture. ".self::COPIE_PROPRE,
+            self::ImageIllisible => "Le fichier « {$nom} » est refusé : cette image ne se lit pas. Photographiez de nouveau le document, ou joignez-le en PDF.",
+            self::ImageTropGrande => "Le fichier « {$nom} » est refusé : cette image est trop grande (plus de 16 000 pixels de côté ou de 40 millions de pixels). Réduisez-la, ou joignez le document en PDF.",
+            self::Menace => "Le fichier « {$nom} » est refusé : l'antivirus y a trouvé une menace. Ne l'ouvrez pas sur votre poste, et demandez une copie saine à son expéditeur.",
+            self::AntivirusInjoignable => "Le fichier « {$nom} » n'a pas pu être analysé par l'antivirus : réessayez dans quelques minutes.",
+            self::AnalyseIndisponible => "Le fichier « {$nom} » n'a pas pu être analysé : réessayez dans quelques minutes.",
+        };
+    }
+
+    /**
+     * « a », « a et b », « a, b et c ».
+     *
+     * @param  list<string>  $elements
+     */
+    private static function enumerer(array $elements): string
+    {
+        $dernier = array_pop($elements);
+
+        return $elements === [] ? (string) $dernier : implode(', ', $elements).' et '.$dernier;
+    }
+}
diff --git a/app/Domain/Fichiers/Exceptions/FichierRefuseException.php b/app/Domain/Fichiers/Exceptions/FichierRefuseException.php
new file mode 100644
index 0000000..70e9e24
--- /dev/null
+++ b/app/Domain/Fichiers/Exceptions/FichierRefuseException.php
@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Domain\Fichiers\Exceptions;
+
+use App\Domain\Fichiers\Enums\ContenuActif;
+use App\Domain\Fichiers\Enums\RaisonDuRefus;
+use App\Domain\Fichiers\NomDeFichier;
+use App\Domain\Fichiers\PieceDeposee;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use InvalidArgumentException;
+
+/**
+ * Un fichier reçu refusé par ses contrôles (voir ControleDesFichiers) :
+ * rien n'est enregistré, et l'écran, ou l'API, dit pourquoi et quoi faire.
+ * Il garde, pour le journal d'audit, ce que la personne a déposé : le nom
+ * tel que reçu, comme donnée, l'empreinte SHA-256 et la taille du fichier
+ * reçu, jamais son contenu, et ce qu'un PDF refusé pour son code actif
+ * contient, ou la menace que l'antivirus y a trouvée.
+ */
+final class FichierRefuseException extends InvalidArgumentException
+{
+    /**
+     * @param  list<ContenuActif>  $contenus
+     */
+    public function __construct(
+        public readonly RaisonDuRefus $raison,
+        public readonly string $nomRecu,
+        public readonly string $empreinteRecue,
+        public readonly int $tailleRecue,
+        public readonly array $contenus = [],
+        public readonly ?string $menace = null,
+    ) {
+        parent::__construct($raison->message(NomDeFichier::pourUnMessage($nomRecu), $contenus));
+    }
+
+    /**
+     * Le refus de ce fichier déposé, pour cette raison.
+     *
+     * @param  list<ContenuActif>  $contenus
+     */
+    public static function pour(PieceDeposee $piece, RaisonDuRefus $raison, array $contenus = [], ?string $menace = null): self
+    {
+        return new self($raison, $piece->nom, hash('sha256', $piece->contenu), strlen($piece->contenu), $contenus, $menace);
+    }
+
+    /**
+     * Ce que le journal d'audit retient du refus : sa raison, ce qu'un PDF
+     * contient ou la menace trouvée, et le fichier reçu (nom, empreinte,
+     * taille).
+     *
+     * @return array{raison: string, detail: list<string>|string|null, nom_recu: string, empreinte_recue: string, taille_recue: int}
+     */
+    public function valeursAuditees(): array
+    {
+        return [
+            'raison' => $this->raison->value,
+            'detail' => $this->contenus !== [] ? array_map(fn (ContenuActif $contenu): string => $contenu->value, $this->contenus) : $this->menace,
+            'nom_recu' => $this->nomRecu,
+            'empreinte_recue' => $this->empreinteRecue,
+            'taille_recue' => $this->tailleRecue,
+        ];
+    }
+
+    /**
+     * Demandé par l'API, le refus est une erreur 422 qui dit sa raison ;
+     * ailleurs, l'écran le montre (voir GereLesExceptionsMetier).
+     */
+    public function render(Request $request): ?JsonResponse
+    {
+        if (! $request->expectsJson()) {
+            return null;
+        }
+
+        return new JsonResponse([
+            'message' => $this->getMessage(),
+            'raison' => $this->raison->value,
+        ], 422);
+    }
+}
diff --git a/app/Domain/Fichiers/Exceptions/PieceBloqueeException.php b/app/Domain/Fichiers/Exceptions/PieceBloqueeException.php
new file mode 100644
