+        }
+
+        $relatif = $dossier.$entree;
+
+        if (is_dir(RACINE.'/app/'.$relatif)) {
+            $sensibles = array_filter(
+                array_map(fn (string $fichier): string => substr($fichier, strlen(RACINE) + 1), glob_recursif(RACINE.'/app/'.$relatif)),
+                fn (string $fichier): bool => in_array(partieDe($fichier), PARTIES_SENSIBLES, true),
+            );
+            $exclusions = $sensibles === []
+                ? [...$exclusions, '#^'.preg_quote($relatif.'/', '#').'#']
+                : [...$exclusions, ...exclusionsHorsDesPartiesSensibles($relatif.'/')];
+        } elseif (! in_array(partieDe('app/'.$relatif), PARTIES_SENSIBLES, true)) {
+            $exclusions[] = '#^'.preg_quote($relatif, '#').'$#';
+        }
+    }
+
+    return $exclusions;
+}
+
+/**
+ * @return list<string> les fichiers PHP sous ce dossier, chemins absolus
+ */
+function glob_recursif(string $dossier): array
+{
+    $fichiers = [];
+
+    foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dossier, FilesystemIterator::SKIP_DOTS)) as $fichier) {
+        if ($fichier->isFile() && str_ends_with($fichier->getFilename(), '.php')) {
+            $fichiers[] = $fichier->getPathname();
+        }
+    }
+
+    return $fichiers;
+}
+
+function configurationSensibles(string $destination): int
+{
+    $configuration = json_decode((string) preg_replace('#^\s*//.*$#m', '', (string) file_get_contents(RACINE.'/infection.json5')), true, flags: JSON_THROW_ON_ERROR);
+    $configuration['$schema'] = RACINE.'/vendor/infection/infection/resources/schema.json';
+    $configuration['source'] = ['directories' => [RACINE.'/app'], 'excludes' => exclusionsHorsDesPartiesSensibles()];
+    $configuration['tmpDir'] = RACINE.'/'.$configuration['tmpDir'];
+    $configuration['logs'] = array_map(fn (string $journal): string => RACINE.'/'.$journal, $configuration['logs']);
+    $configuration['phpUnit'] = ['configDir' => RACINE];
+    file_put_contents($destination, json_encode($configuration, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR)."\n");
+
+    return 0;
+}
+
+/**
+ * Dans le rapport de couverture XML que lit Infection, met d'abord, pour
+ * chaque ligne, les tests unitaires qui l'exécutent. Infection range les
+ * tests d'un mutant par tranches de durée (un huitième de seconde), sans
+ * ordre dans une tranche, et PHPUnit les lance fichier par fichier : le
+ * rapport de PHPUnit les donnant par ordre alphabétique, les tests de
+ * Feature passaient avant ceux de Unit, et un mutant qu'un test unitaire
+ * arrête en quelques millisecondes épuisait le délai d'Infection sur des
+ * tests de base de données (« non conclu »). L'ensemble des tests de
+ * chaque ligne ne change pas, seulement leur ordre. Chaque fichier se
+ * réécrit à part puis prend la place de l'ancien, sans jamais modifier un
+ * fichier partagé par un lien.
+ */
+function couvertureUnitaireDAbord(string $dossier): int
+{
+    foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dossier, FilesystemIterator::SKIP_DOTS)) as $fichier) {
+        if (! $fichier->isFile() || ! str_ends_with($fichier->getFilename(), '.php.xml')) {
+            continue;
+        }
+
+        $chemin = $fichier->getPathname();
+        $source = fopen($chemin, 'r') ?: throw new RuntimeException("Rapport illisible : {$chemin}");
+        $copie = $chemin.'.unitaire-d-abord';
+        $cible = fopen($copie, 'w') ?: throw new RuntimeException("Écriture impossible : {$copie}");
+        $unitaires = [];
+        $autres = [];
+
+        while (($ligne = fgets($source)) !== false) {
+            if (str_contains($ligne, '<covered by="')) {
+                str_contains($ligne, 'by="Tests\\Unit\\') ? $unitaires[] = $ligne : $autres[] = $ligne;
+
+                continue;
+            }
+
+            fwrite($cible, implode('', [...$unitaires, ...$autres]).$ligne);
+            $unitaires = [];
+            $autres = [];
+        }
+
+        fwrite($cible, implode('', [...$unitaires, ...$autres]));
+        fclose($source);
+        fclose($cible);
+        rename($copie, $chemin);
+    }
+
+    return 0;
+}
