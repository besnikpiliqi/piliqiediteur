diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index e89aefa..fb1b1ec 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -37,6 +37,160 @@ jobs:
       - name: Check code style
         run: vendor/bin/pint --test
 
+  # Analyse statique (Larastan) au niveau de phpstan.neon, sans fichier de
+  # référence ; puis aucun seuil de tests/Qualite/seuils.json (niveau de
+  # l'analyse, couverture et score de mutation de chaque partie) ne baisse
+  # par rapport au commit précédent de la branche, ou à la base de la
+  # demande de fusion.
+  analyse:
+    runs-on: ubuntu-latest
+
+    name: Analyse statique et seuils
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+          fetch-depth: 0
+
+      - name: Setup PHP
+        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # v2
+        with:
+          php-version: 8.3
+          extensions: dom, curl, libxml, mbstring, zip, pcntl, pdo, sqlite, pdo_sqlite, pdo_pgsql, sockets
+          coverage: none
+
+      - name: Install Composer dependencies
+        run: composer install --prefer-dist --no-interaction --no-progress
+
+      - name: Copy environment file
+        run: cp .env.example .env
+
+      - name: Larastan
+        run: vendor/bin/phpstan analyse --no-progress --memory-limit=3G --error-format=github
+
+      - name: Seuils qui ne baissent pas
+        env:
+          BASE: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.event.before }}
+        run: |
+          if [ -n "$BASE" ] && git cat-file -e "$BASE:tests/Qualite/seuils.json" 2>/dev/null; then
+            git show "$BASE:tests/Qualite/seuils.json" > "$RUNNER_TEMP/seuils-precedents.json"
+            php tests/Qualite/qualite.php seuils "$RUNNER_TEMP/seuils-precedents.json"
+          else
+            php tests/Qualite/qualite.php seuils tests/Qualite/seuils.json
+          fi
+
+  # Sécurité des dépendances : une faille connue d'un paquet du dépôt fait
+  # échouer la CI ; elle se corrige par la mise à jour du paquet.
+  audit:
+    runs-on: ubuntu-latest
+
+    name: Audit des dépendances
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Setup PHP
+        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # v2
+        with:
+          php-version: 8.3
+          extensions: dom, curl, libxml, mbstring, zip, pcntl, pdo, sqlite, pdo_sqlite, pdo_pgsql, sockets
+          coverage: none
+
+      - name: Setup Node
+        uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6.5.0
+        with:
+          node-version: 22
+
+      - name: Composer audit
+        run: composer audit --locked --no-interaction
+
+      - name: npm audit
+        run: npm audit --package-lock-only
+
+  # Couverture du code (PCOV) de toute la suite, tests en navigateur
+  # compris, sur SQLite : chaque partie tient son seuil, et chaque ligne de
+  # app/ ajoutée ou modifiée par l'envoi est exécutée par un test. Puis
+  # tests de mutation (Infection) des parties sensibles changées par
+  # l'envoi, chacune à son score minimal. Rapports gardés en artefact.
+  couverture:
+    runs-on: ubuntu-latest
+
+    name: Couverture et mutation
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+          fetch-depth: 0
+
+      - name: Setup PHP
+        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # v2
+        with:
+          php-version: 8.3
+          extensions: dom, curl, libxml, mbstring, zip, pcntl, pdo, sqlite, pdo_sqlite, pdo_pgsql, sockets
+          coverage: pcov
+
+      - name: Install Composer dependencies
+        run: composer install --prefer-dist --no-interaction --no-progress
+
+      - name: Copy environment file
+        run: cp .env.example .env
+
+      - name: Generate app key
+        run: php artisan key:generate
+
+      - name: Setup Node
+        uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6.5.0
+        with:
+          node-version: 22
+          cache: npm
+
+      - name: Install Playwright and its browser
+        run: |
+          npm ci
+          npx playwright install --with-deps chromium
+
+      - name: Tests avec couverture
+        run: php artisan test --parallel --coverage-clover=storage/qualite/clover.xml --coverage-xml=storage/qualite/infection/coverage-xml --log-junit=storage/qualite/infection/junit.xml
+
+      - name: Seuils de couverture par partie
+        run: php tests/Qualite/qualite.php couverture storage/qualite/clover.xml storage/qualite/couverture.md
+
+      - name: Nouveau code couvert
+        if: github.event_name == 'push' && github.event.before != '0000000000000000000000000000000000000000'
+        env:
+          BASE: ${{ github.event.before }}
+        run: php tests/Qualite/qualite.php nouveau-code storage/qualite/clover.xml "$BASE"
+
+      - name: Tests de mutation des parties sensibles changées
+        if: github.event_name == 'push' && github.event.before != '0000000000000000000000000000000000000000'
+        env:
+          BASE: ${{ github.event.before }}
+        run: |
+          vendor/bin/infection --threads=max --git-diff-lines --git-diff-base="$BASE" --filter="$(php tests/Qualite/qualite.php sensibles)" --coverage=storage/qualite/infection --skip-initial-tests --no-progress --ignore-msi-with-no-mutations
+          if [ -f storage/qualite/infection.json ]; then
+            php tests/Qualite/qualite.php mutation storage/qualite/infection.json storage/qualite/mutation.md
+          fi
+
+      - name: Garder les rapports
+        if: always()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: qualite
+          path: |
+            storage/qualite/clover.xml
+            storage/qualite/couverture.md
+            storage/qualite/mutation.md
+            storage/qualite/infection.json
+            storage/qualite/infection.log
+          if-no-files-found: ignore
+
   tests:
     runs-on: ubuntu-latest
 
