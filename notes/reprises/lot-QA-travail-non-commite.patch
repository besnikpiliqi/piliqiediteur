index 0000000..95b89b9
--- /dev/null
+++ b/psalm-temoin.xml
@@ -0,0 +1,41 @@
+<?xml version="1.0"?>
+<!--
+    Configuration du témoin (tests/Qualite/Psalm/Temoin) : la même que
+    psalm.xml, sur le seul témoin, dont l'analyse doit voir exactement les
+    chemins qu'il annonce (php tests/Qualite/qualite.php flux-temoin).
+
+    Analyse des flux de données (taint analysis) de Psalm et de son extension
+    Laravel, décidée par l'éditeur le 07/11/2026 (D54) : chaque donnée venue
+    de l'extérieur (formulaire, adresse, en-tête, fichier envoyé, saisie d'un
+    écran Livewire ou Filament, voir tests/Qualite/Psalm/SaisiesDesEcrans.php
+    et tests/Qualite/Psalm/filament.stub) est suivie jusqu'à une requête SQL,
+    une page, un chemin de fichier, une commande, une redirection, une
+    requête vers un autre site ou un e-mail. Psalm ne sert qu'à cela : le
+    contrôle des types est celui de Larastan (phpstan.neon), et seuls les
+    chemins de sécurité font échouer la CI (php tests/Qualite/qualite.php
+    flux). Psalm s'installe à part, dans tools/psalm (voir le README), et se
+    lance depuis la racine du dépôt, avec l'option de l'analyse des flux et
+    le rapport JSON, comme dans la CI (.github/workflows/tests.yml). Un
+    commentaire XML ne contient jamais deux tirets de suite : la commande
+    s'écrit donc dans le README.
+-->
+<psalm
+    errorLevel="8"
+    findUnusedCode="false"
+    findUnusedBaselineEntry="false"
+    cacheDirectory="storage/framework/cache/psalm-temoin"
+    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+    xmlns="https://getpsalm.org/schema/config"
+    xsi:schemaLocation="https://getpsalm.org/schema/config tools/psalm/vendor/vimeo/psalm/config.xsd"
+>
+    <projectFiles>
+        <directory name="tests/Qualite/Psalm/Temoin"/>
+    </projectFiles>
+    <plugins>
+        <pluginClass class="Psalm\LaravelPlugin\Plugin"/>
+        <plugin filename="tests/Qualite/Psalm/SaisiesDesEcrans.php"/>
+    </plugins>
+    <stubs>
+        <file name="tests/Qualite/Psalm/filament.stub"/>
+    </stubs>
+</psalm>
