diff --git a/resources/views/vendor/filament-notifications/components/close-button.blade.php b/resources/views/vendor/filament-notifications/components/close-button.blade.php
new file mode 100644
index 00000000..5c96753e
--- /dev/null
+++ b/resources/views/vendor/filament-notifications/components/close-button.blade.php
@@ -0,0 +1,17 @@
+{{--
+    La croix d'une notification de Filament
+    (filament-notifications::components.close-button), la même, qui reste
+    active pendant les requêtes de son composant : dans la liste de la
+    cloche, qui regarde s'il y a du nouveau (voir
+    App\Filament\CartesDesNotifications::intervalle()), le bouton de
+    Filament se désactivait pendant chaque regard (wire:loading.attr), et un
+    clic tombé à ce moment se perdait.
+--}}
+<x-filament::icon-button
+    color="gray"
+    icon="heroicon-m-x-mark"
+    icon-alias="notifications::notification.close-button"
+    x-on:click="close"
+    :wire:loading.attr="false"
+    class="fi-no-notification-close-btn"
+/>
diff --git a/resources/views/vendor/filament-notifications/components/database/modal/index.blade.php b/resources/views/vendor/filament-notifications/components/database/modal/index.blade.php
new file mode 100644
index 00000000..aaca2525
--- /dev/null
+++ b/resources/views/vendor/filament-notifications/components/database/modal/index.blade.php
@@ -0,0 +1,107 @@
+{{--
+    La liste de la cloche (filament-notifications::components.database.modal.index),
+    la même, sauf sa croix, posée ici dans l'en-tête à la place de celle de
+    la fenêtre de Filament, à la même place : elle reste active pendant que
+    la cloche regarde s'il y a du nouveau (voir
+    App\Filament\CartesDesNotifications::intervalle()). Le bouton de
+    Filament se désactivait pendant chaque regard (wire:loading.attr), et un
+    clic tombé à ce moment se perdait ; la fenêtre de Filament ne laisse rien
+    changer à sa croix. Sans notification, l'en-tête reprend l'icône, le
+    titre et la phrase que la fenêtre de Filament y met.
+--}}
+@props([
+    'notifications',
+    'unreadNotificationsCount',
+])
+
+@php
+    use Filament\Support\Enums\Alignment;
+
+    $hasNotifications = $notifications->count();
+    $isPaginated = $notifications instanceof \Illuminate\Contracts\Pagination\Paginator && $notifications->hasPages();
+@endphp
+
+<x-filament::modal
+    :alignment="$hasNotifications ? null : Alignment::Center"
+    :aria-labelledby="$hasNotifications ? null : 'database-notifications.heading'"
+    :close-button="false"
+    id="database-notifications"
+    slide-over
+    :sticky-header="$hasNotifications"
+    width="md"
+>
+    <x-slot name="header">
+        <div class="absolute end-6 top-6">
+            <x-filament::icon-button
+                color="gray"
+                icon="heroicon-o-x-mark"
+                icon-alias="modal.close-button"
+                icon-size="lg"
+                :label="__('filament::components/modal.actions.close.label')"
+                tabindex="-1"
+                x-on:click="$dispatch('close-modal', { id: 'database-notifications' })"
+                :wire:loading.attr="false"
+                class="fi-modal-close-btn"
+            />
+        </div>
+
+        @if ($hasNotifications)
+            <div>
+                <x-filament-notifications::database.modal.heading
+                    :unread-notifications-count="$unreadNotificationsCount"
+                />
+
+                <x-filament-notifications::database.modal.actions
+                    :notifications="$notifications"
+                    :unread-notifications-count="$unreadNotificationsCount"
+                />
+            </div>
+        @else
+            <div class="mb-5 flex items-center justify-center">
+                <div class="fi-color-gray rounded-full bg-gray-100 p-3 dark:bg-gray-500/20">
+                    <x-filament::icon
+                        alias="notifications::database.modal.empty-state"
+                        icon="heroicon-o-bell-slash"
