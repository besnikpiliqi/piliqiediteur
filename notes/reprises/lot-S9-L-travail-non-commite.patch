+     * la ligne reprend le prix du catalogue, puis sa quantité augmente.
+     */
+    public function test_apres_un_changement_du_prix_de_la_fiche_l_article_ajoute_rejoint_sa_ligne_au_nouveau_prix(): void
+    {
