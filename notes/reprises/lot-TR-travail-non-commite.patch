@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Domain\Achats\Concerns;
+
+use App\Domain\Calendrier\Casts\Instant;
+use App\Domain\Tenancy\Concerns\BelongsToMagasin;
+use App\Domain\Tenancy\Concerns\FigeLeNomDeSesAuteurs;
+
+/**
+ * Un taux de TVA d'une facture d'achat ou d'un avoir fournisseur
+ * (décision de l'éditeur du 02/11/2026, T1, voir TvaDuFournisseur) : sa
+ * base, la TVA retenue (celle du document du fournisseur), la TVA que
+ * PILIQI calcule, gardée pour la preuve, la TVA que la personne a saisie,
+ * et la confirmation d'un écart au-delà de la tolérance -- son auteur, son
+ * nom au moment de l'opération, son instant en UTC et l'empreinte de
+ * l'écart confirmé. Seul TvaDuFournisseur l'écrit.
+ */
+trait EstUnTauxDuFournisseur
+{
+    use BelongsToMagasin, FigeLeNomDeSesAuteurs;
+
+    /**
+     * @return array<string, string>
+     */
+    protected static function colonnesAuNomFige(): array
+    {
+        return [
+            'ecart_confirme_par' => 'ecart_confirme_par_nom',
+        ];
+    }
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'taux_tva' => 'decimal:2',
+            'base_ht' => 'decimal:2',
+            'montant_tva' => 'decimal:2',
+            'montant_tva_calcule' => 'decimal:2',
+            'montant_tva_saisi' => 'decimal:2',
+            'ecart_confirme_le' => Instant::class,
+            'ordre' => 'integer',
+        ];
+    }
+
+    /**
+     * Un écart au-delà de la tolérance y a-t-il été confirmé ?
+     */
+    public function ecartConfirme(): bool
+    {
+        return $this->ecart_confirme_empreinte !== null;
+    }
+}
diff --git a/app/Domain/Achats/Exceptions/ConfirmationDesEcartsRequiseException.php b/app/Domain/Achats/Exceptions/ConfirmationDesEcartsRequiseException.php
new file mode 100644
index 0000000..1d974eb
--- /dev/null
+++ b/app/Domain/Achats/Exceptions/ConfirmationDesEcartsRequiseException.php
@@ -0,0 +1,45 @@
+<?php
+
+namespace App\Domain\Achats\Exceptions;
+
+use App\Domain\Achats\Services\EcartsDUnTaux;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use LogicException;
+
+/**
+ * Un HT de ligne ou une TVA de taux saisis au-delà de la tolérance, sans
+ * la confirmation qui les garde (décision de l'éditeur du 02/11/2026, T1,
+ * voir TvaDuFournisseur) : rien n'est enregistré, et l'écran, ou l'API,
+ * dit chaque écart et ce qu'il faut faire. Jamais un refus définitif : la
+ * facture existe et se paie à son montant ; confirmés, ces montants
+ * s'enregistrent et le document est marqué « TVA à vérifier ».
+ */
+final class ConfirmationDesEcartsRequiseException extends LogicException
+{
+    public const CONSIGNE = 'Pour garder les montants de la facture, confirmez-les : le document sera marqué « TVA à vérifier ».';
+
+    /**
+     * @param  list<EcartsDUnTaux>  $ecarts
+     */
+    public function __construct(public readonly array $ecarts)
+    {
+        parent::__construct(implode(' ', [...array_merge(...array_map(fn (EcartsDUnTaux $ecart): array => $ecart->avertissements(), $ecarts)), self::CONSIGNE]));
+    }
+
+    /**
+     * Demandée par l'API, la réponse est une erreur 422 qui dit chaque
+     * écart ; ailleurs, l'écran la montre (voir GereLesExceptionsMetier).
+     */
+    public function render(Request $request): ?JsonResponse
+    {
+        if (! $request->expectsJson()) {
+            return null;
+        }
+
+        return new JsonResponse([
+            'message' => $this->getMessage(),
+            'ecarts' => array_map(fn (EcartsDUnTaux $ecart): array => $ecart->enTableau(), $this->ecarts),
+        ], 422);
+    }
+}
