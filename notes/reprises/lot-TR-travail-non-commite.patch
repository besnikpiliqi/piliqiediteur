+        return $ecart > EcartsDUnTaux::TOLERANCE_DU_HT_D_UNE_LIGNE ? $proposition.' Écart de '.$calculateur->enEuros($ecart).', au-delà de 0,02 € : il faudra le confirmer.' : $proposition;
