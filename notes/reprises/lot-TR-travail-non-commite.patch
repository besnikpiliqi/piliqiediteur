diff --git a/app/Domain/Achats/Services/EcartsDUnTaux.php b/app/Domain/Achats/Services/EcartsDUnTaux.php
new file mode 100644
index 0000000..f03ed4c
--- /dev/null
+++ b/app/Domain/Achats/Services/EcartsDUnTaux.php
@@ -0,0 +1,147 @@
+<?php
+
+namespace App\Domain\Achats\Services;
+
+use App\Domain\Facturation\Services\CalculateurLigne;
+
+/**
+ * Ce que la facture d'achat ou la note d'avoir d'un fournisseur écrit pour
+ * un taux de TVA, face à ce que PILIQI propose (décision de l'éditeur du
+ * 02/11/2026, T1, voir TvaDuFournisseur) : sa base, la TVA proposée et la
+ * TVA retenue, et, pour chacune de ses lignes, le HT proposé et le HT
+ * retenu. Un HT de ligne s'écarte de la proposition dans la tolérance
+ * jusqu'à 0,02 €, une TVA jusqu'à 1 centime par ligne du taux ; au-delà,
+ * l'écart se confirme, et le document est marqué « TVA à vérifier ».
+ * Tous les montants sont en centimes, le taux en centièmes de point.
+ */
+final readonly class EcartsDUnTaux
+{
+    /**
+     * L'écart qu'un HT de ligne peut avoir avec sa proposition sans rien
+     * demander, en centimes : la tolérance de la règle Peppol R120.
+     */
+    public const TOLERANCE_DU_HT_D_UNE_LIGNE = 2;
+
+    /**
+     * L'écart qu'une TVA de taux peut avoir avec sa proposition sans rien
+     * demander, en centimes par ligne du taux : un fournisseur qui arrondit
+     * ou tronque la TVA de chaque ligne s'écarte d'au plus autant.
+     */
+    public const TOLERANCE_DE_LA_TVA_PAR_LIGNE = 1;
+
+    public const AVERTISSEMENT_TVA = 'À %s : la TVA saisie (%s) s\'écarte de %s de la base × taux (%s). Vérifiez la facture. Si sa TVA est fausse, demandez une facture rectificative au fournisseur : une TVA facturée à tort n\'est pas déductible.';
+
+    public const AVERTISSEMENT_HT = '« %s » : le HT saisi (%s) s\'écarte de %s de la quantité × le PU HT, remise déduite (%s). Vérifiez la facture.';
+
+    /**
+     * @param  list<array{description: string, reference: string|null, ht_calcule: int, ht_retenu: int}>  $lignes  chaque ligne du taux, dans son ordre
+     */
+    public function __construct(
+        public int $taux,
+        public int $base,
+        public int $tvaCalculee,
+        public int $tvaRetenue,
+        public array $lignes,
+    ) {}
+
+    /**
+     * Les lignes dont le HT retenu s'écarte de plus de 0,02 € de sa
+     * proposition.
+     *
+     * @return list<array{description: string, reference: string|null, ht_calcule: int, ht_retenu: int}>
+     */
+    public function lignesHorsTolerance(): array
+    {
+        return array_values(array_filter(
+            $this->lignes,
+            fn (array $ligne): bool => abs($ligne['ht_retenu'] - $ligne['ht_calcule']) > self::TOLERANCE_DU_HT_D_UNE_LIGNE,
+        ));
+    }
+
+    /**
+     * La TVA retenue s'écarte-t-elle de plus d'un centime par ligne du taux
+     * de la TVA proposée ?
+     */
+    public function tvaHorsTolerance(): bool
+    {
+        return abs($this->tvaRetenue - $this->tvaCalculee) > self::TOLERANCE_DE_LA_TVA_PAR_LIGNE * count($this->lignes);
+    }
+
+    /**
+     * Un écart de ce taux demande-t-il une confirmation ?
+     */
+    public function depasseLaTolerance(): bool
+    {
+        return $this->tvaHorsTolerance() || $this->lignesHorsTolerance() !== [];
+    }
+
+    /**
+     * L'empreinte de ce que la confirmation de ces écarts confirme : le
+     * taux, sa base, ses deux TVA et, pour chaque ligne, ses deux HT. Le
+     * même écart, enregistré de nouveau, ne se reconfirme pas.
+     */
+    public function empreinte(): string
+    {
+        return hash('sha256', json_encode([
+            $this->taux,
+            $this->base,
+            $this->tvaCalculee,
+            $this->tvaRetenue,
+            array_map(fn (array $ligne): array => [$ligne['ht_calcule'], $ligne['ht_retenu']], $this->lignes),
+        ], JSON_THROW_ON_ERROR));
+    }
+
+    /**
+     * Ce que l'écran et le refus disent de chaque écart au-delà de la
+     * tolérance.
+     *
+     * @return list<string>
+     */
+    public function avertissements(): array
+    {
+        $calculateur = app(CalculateurLigne::class);
+        $avertissements = array_map(fn (array $ligne): string => sprintf(
+            self::AVERTISSEMENT_HT,
+            $ligne['description'],
+            $calculateur->enEuros($ligne['ht_retenu']),
+            $calculateur->enEuros(abs($ligne['ht_retenu'] - $ligne['ht_calcule'])),
+            $calculateur->enEuros($ligne['ht_calcule']),
+        ), $this->lignesHorsTolerance());
+
+        if ($this->tvaHorsTolerance()) {
+            $avertissements[] = sprintf(
+                self::AVERTISSEMENT_TVA,
+                CalculateurLigne::tauxEnTexte($this->taux),
+                $calculateur->enEuros($this->tvaRetenue),
+                $calculateur->enEuros(abs($this->tvaRetenue - $this->tvaCalculee)),
+                $calculateur->enEuros($this->tvaCalculee),
+            );
+        }
+
+        return $avertissements;
+    }
+
+    /**
+     * L'écart tel que le journal d'audit le retient : le taux, la base, la
+     * TVA saisie, la TVA calculée et leur écart, et chaque ligne hors
+     * tolérance avec sa référence, ses deux HT et leur écart, en centimes.
+     *
+     * @return array{taux: int, base: int, tva_saisie: int, tva_calculee: int, ecart: int, lignes: list<array{reference: string|null, ht_saisi: int, ht_calcule: int, ecart: int}>}
+     */
+    public function enTableau(): array
+    {
+        return [
+            'taux' => $this->taux,
+            'base' => $this->base,
+            'tva_saisie' => $this->tvaRetenue,
+            'tva_calculee' => $this->tvaCalculee,
+            'ecart' => $this->tvaRetenue - $this->tvaCalculee,
+            'lignes' => array_map(fn (array $ligne): array => [
+                'reference' => $ligne['reference'],
+                'ht_saisi' => $ligne['ht_retenu'],
+                'ht_calcule' => $ligne['ht_calcule'],
+                'ecart' => $ligne['ht_retenu'] - $ligne['ht_calcule'],
+            ], $this->lignesHorsTolerance()),
+        ];
+    }
+}
diff --git a/app/Domain/Achats/Services/MontantsDuFournisseur.php b/app/Domain/Achats/Services/MontantsDuFournisseur.php
new file mode 100644
index 0000000..c431159
--- /dev/null
+++ b/app/Domain/Achats/Services/MontantsDuFournisseur.php
@@ -0,0 +1,142 @@
+<?php
+
+namespace App\Domain\Achats\Services;
+
+use App\Domain\Facturation\Services\CalculateurLigne;
+use App\Domain\Facturation\Services\DocumentChiffre;
+use App\Domain\Facturation\Services\SaisieDecimale;
+use InvalidArgumentException;
+
+/**
+ * Ce que la facture d'achat ou la note d'avoir d'un fournisseur écrit au
+ * niveau du document, recopié par la personne qui la saisit ou par l'API
+ * (décision de l'éditeur du 02/11/2026, T1) : la TVA de chaque taux, quand
+ * elle n'est pas celle que PILIQI propose, la base de chaque taux (l'API
+ * seulement : la somme des HT de ses lignes, contrôlée), le total TTC saisi
+ * pour contrôle, et la confirmation des écarts au-delà de la tolérance
+ * (voir TvaDuFournisseur). Le HT écrit de chaque ligne voyage avec sa
+ * ligne. Montants en centimes, taux en centièmes de point.
+ */
+final readonly class MontantsDuFournisseur
+{
+    public const REFUS_BASE = 'La base à %s écrite sur la facture (%s) n\'est pas la somme des HT de ses lignes (%s) : saisissez le HT de chaque ligne tel que la facture l\'écrit.';
+
+    public const REFUS_TOTAL_TTC = 'Le total TTC saisi (%s) ne vaut pas le total HT plus la TVA de la facture (%s + %s = %s) : vérifiez les montants saisis.';
+
+    /**
+     * @param  array<int, int>  $tvaParTaux  la TVA écrite, par taux
+     * @param  array<int, int>  $baseParTaux  la base écrite, par taux
+     * @param  int|null  $totalTtc  le total TTC écrit, saisi pour contrôle
+     * @param  bool  $confirmation  les écarts au-delà de la tolérance sont confirmés
+     */
+    public function __construct(
+        public array $tvaParTaux = [],
+        public array $baseParTaux = [],
+        public ?int $totalTtc = null,
+        public bool $confirmation = false,
+    ) {}
+
+    /**
+     * Rien d'écrit : les propositions de PILIQI, comme avant cette
+     * décision.
+     */
+    public static function aucun(): self
+    {
+        return new self;
+    }
+
+    /**
+     * La saisie d'un écran ou d'un appel de l'API : « taux », une liste de
+     * taux avec leur TVA (« montant_tva ») et, pour l'API, leur base
+     * (« base_ht ») ; « total_ttc » ; « confirmation ». Une TVA, une base ou
+     * un total laissés vides ne disent rien. Un montant s'écrit au centime
+     * (voir SaisieDecimale::montantAuCentime()).
+     *
+     * @param  array{taux?: iterable<array{taux_tva?: mixed, montant_tva?: mixed, base_ht?: mixed}>|null, total_ttc?: mixed, confirmation?: mixed}  $saisie
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function depuisLaSaisie(array $saisie): self
+    {
+        $tvaParTaux = [];
+        $baseParTaux = [];
+
+        foreach ($saisie['taux'] ?? [] as $taux) {
+            if (! is_array($taux) || blank($taux['taux_tva'] ?? null)) {
+                continue;
+            }
+
+            $cle = SaisieDecimale::enCentiemes($taux['taux_tva']);
+
+            if (filled($taux['montant_tva'] ?? null)) {
+                $tvaParTaux[$cle] = SaisieDecimale::montantAuCentime($taux['montant_tva']);
+            }
+
+            if (filled($taux['base_ht'] ?? null)) {
+                $baseParTaux[$cle] = SaisieDecimale::montantAuCentime($taux['base_ht']);
+            }
+        }
+
+        return new self(
+            $tvaParTaux,
+            $baseParTaux,
+            filled($saisie['total_ttc'] ?? null) ? SaisieDecimale::montantAuCentime($saisie['total_ttc']) : null,
+            (bool) ($saisie['confirmation'] ?? false),
+        );
+    }
+
+    /**
+     * La même saisie, la confirmation en plus ou en moins.
+     */
+    public function avecLaConfirmation(bool $confirmation): self
+    {
+        return new self($this->tvaParTaux, $this->baseParTaux, $this->totalTtc, $confirmation);
+    }
+
+    /**
+     * Refuse une base écrite qui n'est pas la somme des HT des lignes de son
+     * taux, ou un total TTC saisi qui ne vaut pas le total HT plus la TVA du
+     * document : une erreur de saisie, qu'aucune facture valable ne porte.
+     *
+     * @throws InvalidArgumentException
+     */
+    public function verifier(DocumentChiffre $document): void
+    {
+        $calculateur = app(CalculateurLigne::class);
+
+        foreach ($this->baseParTaux as $taux => $base) {
+            $calculee = $calculateur->enCentiemes($document->parTaux[$calculateur->enDecimal($taux)]['montant_ht'] ?? 0);
+
+            if ($base !== $calculee) {
+                throw new InvalidArgumentException(sprintf(self::REFUS_BASE, CalculateurLigne::tauxEnTexte($taux), $calculateur->enEuros($base), $calculateur->enEuros($calculee)));
+            }
+        }
+
+        if ($this->totalTtc === null) {
+            return;
+        }
+
+        $ht = $calculateur->enCentiemes($document->totaux['total_ht']);
+        $tva = $calculateur->enCentiemes($document->totaux['total_tva']);
+
+        if ($this->totalTtc !== $ht + $tva) {
+            throw new InvalidArgumentException(sprintf(self::REFUS_TOTAL_TTC, $calculateur->enEuros($this->totalTtc), $calculateur->enEuros($ht), $calculateur->enEuros($tva), $calculateur->enEuros($ht + $tva)));
+        }
+    }
+
+    /**
+     * La saisie telle qu'elle distingue une demande d'une autre (voir
+     * ActionsUniques).
+     *
+     * @return array{tva_par_taux: array<int, int>, base_par_taux: array<int, int>, total_ttc: int|null, confirmation: bool}
+     */
+    public function enTableau(): array
+    {
+        return [
+            'tva_par_taux' => $this->tvaParTaux,
+            'base_par_taux' => $this->baseParTaux,
+            'total_ttc' => $this->totalTtc,
+            'confirmation' => $this->confirmation,
+        ];
+    }
+}
diff --git a/app/Domain/Achats/Services/TvaDuFournisseur.php b/app/Domain/Achats/Services/TvaDuFournisseur.php
new file mode 100644
index 0000000..c6575c9
--- /dev/null
+++ b/app/Domain/Achats/Services/TvaDuFournisseur.php
@@ -0,0 +1,218 @@
+<?php
+
+namespace App\Domain\Achats\Services;
+
+use App\Domain\Achats\Exceptions\ConfirmationDesEcartsRequiseException;
+use App\Domain\Achats\Models\AvoirFournisseur;
+use App\Domain\Achats\Models\FactureAchat;
+use App\Domain\Facturation\Services\CalculateurLigne;
+use App\Domain\Facturation\Services\DocumentChiffre;
+use App\Domain\Tenancy\Enums\ActionAuditee;
+use App\Domain\Tenancy\Exceptions\JournalAuditNonConfigureException;
+use App\Domain\Tenancy\Services\JournalAudit;
+use App\Models\User;
+use Carbon\CarbonImmutable;
+use Illuminate\Database\Eloquent\Model;
+
+/**
+ * La TVA d'un achat est celle qu'écrit le document du fournisseur
+ * (décision de l'éditeur du 02/11/2026, T1 ; CGI, art. 271, II-1-a ; BOFiP
+ * BOI-TVA-DED-40-10-10) : pour chaque taux d'une facture d'achat ou d'un
+ * avoir fournisseur, PILIQI enregistre la base et la TVA de la facture ou
+ * de la note d'avoir, qui prime (BOI-TVA-DECLA-30-20-20-20 § 260), et garde
+ * celle qu'il calcule pour la preuve (voir TauxFactureAchat et
+ * TauxAvoirFournisseur).
+ *
+ * Il accepte sans rien demander un HT de ligne à 0,02 € au plus de sa
+ * proposition et une TVA à 1 centime par ligne du taux au plus (voir
+ * EcartsDUnTaux). Au-delà, l'écart se confirme : sans la confirmation, rien
+ * ne s'enregistre (voir ConfirmationDesEcartsRequiseException) ; confirmé,
+ * il s'inscrit au journal d'audit (auteur, montants, écarts) et le document
+ * est marqué « TVA à vérifier », marque visible de tous ceux qui voient les
+ * achats, cabinet lié compris, qui n'a jamais accès au journal d'audit. Le
+ * même écart, enregistré de nouveau, ne se reconfirme pas : sa
+ * confirmation, son auteur et son instant restent, par l'empreinte de ce
+ * qui a été confirmé ; deux confirmations simultanées du même écart, que
+ * le verrou du document fait passer l'une après l'autre, n'en inscrivent
+ * qu'une. La marque se lève quand le document est corrigé dans la
+ * tolérance ; chaque pose et chaque levée s'inscrit au journal d'audit.
+ *
+ * L'action qui enregistre le document l'appelle en dernier, sous le verrou
+ * du document, après tout autre verrou : le journal d'audit se verrouille
+ * après tous les autres (voir JournalAudit).
+ */
+class TvaDuFournisseur
+{
+    public function __construct(
+        private readonly CalculateurLigne $calculateur,
+        private readonly JournalAudit $journalAudit,
+    ) {}
+
+    /**
+     * Les écarts de chaque taux d'un document chiffré, par taux écrit comme
+     * sa colonne (« 20.00 »), dans l'ordre où il apparaît : chaque ligne
+     * avec sa description, sa référence, son taux, son HT retenu
+     * (montant_ht) et son HT proposé (montant_ht_calcule) ; chaque taux
+     * avec sa base (montant_ht), sa TVA retenue (montant_tva) et sa TVA
+     * proposée (montant_tva_calcule).
+     *
+     * @return array<string, EcartsDUnTaux>
+     */
+    public function ecarts(DocumentChiffre $document): array
+    {
+        $ecarts = [];
+
+        foreach ($document->parTaux as $taux => $montants) {
+            $lignes = array_filter($document->lignes, fn (array $ligne): bool => $this->calculateur->enDecimal($this->calculateur->enCentiemes((string) $ligne['taux_tva'])) === (string) $taux);
+            $ecarts[(string) $taux] = new EcartsDUnTaux(
+                $this->calculateur->enCentiemes((string) $taux),
+                $this->calculateur->enCentiemes($montants['montant_ht']),
+                $this->calculateur->enCentiemes($montants['montant_tva_calcule']),
+                $this->calculateur->enCentiemes($montants['montant_tva']),
+                array_values(array_map(fn (array $ligne): array => [
+                    'description' => (string) $ligne['description'],
+                    'reference' => $ligne['reference'] ?? null,
+                    'ht_calcule' => $this->calculateur->enCentiemes($ligne['montant_ht_calcule']),
+                    'ht_retenu' => $this->calculateur->enCentiemes($ligne['montant_ht']),
+                ], $lignes)),
+            );
+        }
+
+        return $ecarts;
+    }
+
+    /**
+     * Les écarts au-delà de la tolérance que le document enregistré n'a pas
+     * déjà confirmés : ceux que son enregistrement demanderait de confirmer
+     * (voir retenir()), et que l'écran demande de confirmer.
+     *
+     * @return list<EcartsDUnTaux>
+     */
+    public function ecartsAConfirmer(DocumentChiffre $document, FactureAchat|AvoirFournisseur|null $enregistre): array
+    {
+        $confirmes = $enregistre?->taux()->whereNotNull('ecart_confirme_empreinte')->pluck('ecart_confirme_empreinte')->all() ?? [];
+
+        return array_values(array_filter(
+            $this->ecarts($document),
+            fn (EcartsDUnTaux $ecart): bool => $ecart->depasseLaTolerance() && ! in_array($ecart->empreinte(), $confirmes, true),
+        ));
+    }
+
+    /**
+     * Enregistre la TVA de chaque taux du document chiffré, à la place de
+     * celle qu'il avait : sa base, sa TVA retenue, sa TVA calculée et la TVA
+     * saisie ; confirme les écarts nouveaux au-delà de la tolérance, que la
+     * saisie doit confirmer, et pose ou lève la marque « TVA à vérifier ».
+     *
+     * @throws ConfirmationDesEcartsRequiseException
+     * @throws JournalAuditNonConfigureException
+     */
+    public function retenir(User $compte, FactureAchat|AvoirFournisseur $document, DocumentChiffre $chiffre, MontantsDuFournisseur $montants): void
+    {
+        $ecarts = $this->ecarts($chiffre);
+        $existants = $document->taux()->get()->keyBy(fn (Model $taux): string => (string) $taux->getAttribute('taux_tva'));
+        $nouveaux = array_filter(
+            $ecarts,
+            fn (EcartsDUnTaux $ecart, string $taux): bool => $ecart->depasseLaTolerance() && $existants->get($taux)?->getAttribute('ecart_confirme_empreinte') !== $ecart->empreinte(),
+            ARRAY_FILTER_USE_BOTH,
+        );
+
+        if ($nouveaux !== [] && ! $montants->confirmation) {
+            throw new ConfirmationDesEcartsRequiseException(array_values($nouveaux));
+        }
+
+        $maintenant = CarbonImmutable::now();
+
+        $this->enregistrerLesTaux($document, $ecarts, $montants, function (Model $ligne, EcartsDUnTaux $ecart, string $taux) use ($compte, $nouveaux, $maintenant): void {
+            if (! $ecart->depasseLaTolerance()) {
