+
+                if (isset($saisie[2])) {
+                    $element->selectText();
+                    $element->type($valeur, ['delay' => $saisie[2]]);
+                } else {
+                    $element->fill($valeur);
+                }
+            }
+        }, 'la saisie de '.count($saisies).' champs sans attendre la page');
