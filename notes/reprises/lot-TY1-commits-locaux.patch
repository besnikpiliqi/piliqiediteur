diff --git a/tests/Feature/Tenancy/ExpressionDUneColonneTest.php b/tests/Feature/Tenancy/ExpressionDUneColonneTest.php
new file mode 100644
index 0000000..53bf648
--- /dev/null
+++ b/tests/Feature/Tenancy/ExpressionDUneColonneTest.php
@@ -0,0 +1,36 @@
+<?php
+
+namespace Tests\Feature\Tenancy;
+
+use App\Domain\Tenancy\Support\ExpressionDUneColonne;
+use Illuminate\Support\Facades\DB;
+use Tests\TestCase;
+
+/**
+ * Une expression SQL du code autour d'une colonne (voir
+ * ExpressionDUneColonne) : la grammaire de PostgreSQL écrit à la place de
+ * chaque « {colonne} » le nom de la colonne protégé, qualifié par sa table,
+ * et le constructeur de requêtes l'accepte comme toute expression.
+ */
+class ExpressionDUneColonneTest extends TestCase
+{
+    public function test_chaque_marque_devient_la_colonne_protegee_par_la_grammaire(): void
+    {
+        $grammaire = DB::connection()->getQueryGrammar();
+
+        $this->assertSame('lower("clients"."nom") || "clients"."nom"', (new ExpressionDUneColonne('lower('.ExpressionDUneColonne::COLONNE.') || '.ExpressionDUneColonne::COLONNE, 'clients.nom'))->getValue($grammaire));
+        $this->assertSame('"nom""; drop table clients; --" is null', (new ExpressionDUneColonne(ExpressionDUneColonne::COLONNE.' is null', 'nom"; drop table clients; --'))->getValue($grammaire));
+    }
+
+    public function test_le_constructeur_de_requetes_l_execute_comme_toute_expression(): void
+    {
+        $noms = DB::query()
+            ->fromRaw("(values ('Pain'), ('Lait'), ('PAIN')) as t(nom)")
+            ->where(new ExpressionDUneColonne('lower('.ExpressionDUneColonne::COLONNE.')', 't.nom'), 'pain')
+            ->orderBy(new ExpressionDUneColonne(ExpressionDUneColonne::COLONNE.' collate "C"', 't.nom'))
+            ->pluck('nom')
+            ->all();
+
+        $this->assertSame(['PAIN', 'Pain'], $noms);
+    }
+}
diff --git a/tests/Feature/Tenancy/LitteralSqlTest.php b/tests/Feature/Tenancy/LitteralSqlTest.php
new file mode 100644
index 0000000..de1ff9f
--- /dev/null
+++ b/tests/Feature/Tenancy/LitteralSqlTest.php
@@ -0,0 +1,60 @@
+<?php
+
+namespace Tests\Feature\Tenancy;
+
+use App\Domain\Tenancy\Support\LitteralSql;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+use Tests\TestCase;
+
+/**
+ * Un texte du code écrit en littéral SQL entre dollars (voir LitteralSql) :
+ * PostgreSQL le relit tel quel, apostrophes et barres obliques inverses
+ * comprises, dans une requête comme dans le corps d'une fonction entre
+ * dollars ; un texte vide ou qui contient un dollar, qui pourrait le
+ * terminer, est refusé.
+ */
+class LitteralSqlTest extends TestCase
+{
+    public function test_postgresql_relit_tel_quel_le_texte_ecrit_entre_dollars(): void
+    {
+        $relu = DB::selectOne('SELECT '.LitteralSql::de('une pièce ne s\'efface que d\'un brouillon \\ ; fin').' AS texte');
+
+        $this->assertSame('$texte$une pièce ne s\'efface que d\'un brouillon \\ ; fin$texte$', LitteralSql::de('une pièce ne s\'efface que d\'un brouillon \\ ; fin'));
+        $this->assertSame('une pièce ne s\'efface que d\'un brouillon \\ ; fin', $relu->texte);
+    }
+
+    public function test_le_corps_d_une_fonction_entre_dollars_garde_le_texte_tel_quel(): void
+    {
+        DB::beginTransaction();
+
+        try {
+            DB::unprepared('CREATE FUNCTION pg_temp.litteral_entre_dollars() RETURNS text LANGUAGE sql AS $$ SELECT '.LitteralSql::de('l\'apostrophe et la barre \\').' $$');
+            $relu = DB::selectOne('SELECT pg_temp.litteral_entre_dollars() AS texte');
+        } finally {
+            DB::rollBack();
+        }
+
+        $this->assertSame('l\'apostrophe et la barre \\', $relu->texte);
+    }
+
+    public function test_un_texte_qui_contient_un_dollar_est_refuse(): void
+    {
+        $this->expectException(InvalidArgumentException::class);
+        $this->expectExceptionMessage(LitteralSql::REFUS_DOLLAR);
+
+        LitteralSql::de('100 $');
+    }
+
+    /**
+     * Vide, il s'écrirait « $texte$$texte$ », où PostgreSQL lirait la fin du
+     * corps entre dollars de la fonction qui le contient.
+     */
+    public function test_un_texte_vide_est_refuse(): void
+    {
+        $this->expectException(InvalidArgumentException::class);
+        $this->expectExceptionMessage(LitteralSql::REFUS_VIDE);
+
+        LitteralSql::de('');
+    }
+}
