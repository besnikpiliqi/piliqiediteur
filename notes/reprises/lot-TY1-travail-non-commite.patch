diff --git a/app/Domain/Tenancy/Support/CompteConnecte.php b/app/Domain/Tenancy/Support/CompteConnecte.php
new file mode 100644
index 0000000..e6dcddb
--- /dev/null
+++ b/app/Domain/Tenancy/Support/CompteConnecte.php
@@ -0,0 +1,32 @@
+<?php
+
+namespace App\Domain\Tenancy\Support;
+
+use App\Models\User;
+use Illuminate\Support\Facades\Auth;
+use RuntimeException;
+
+/**
+ * Le compte connecté, lu là où seul un compte connecté arrive : les pages,
+ * les actions et les tableaux des panneaux de Filament, derrière leur
+ * contrôle de l'authentification, et les routes de l'espace qui l'exigent.
+ * Sans compte connecté, c'est une erreur du code, refusée par une
+ * exception, et non un visiteur à qui répondre ; jamais le refus d'un
+ * geste (une LogicException, que les écrans montrent à la personne, voir
+ * GereLesExceptionsMetier) : comme l'erreur de PHP qu'elle remplace, elle
+ * remonte jusqu'au journal de l'application.
+ */
+final class CompteConnecte
+{
+    public const REFUS = 'Aucun compte n\'est connecté : cette page ou cette action exige une connexion.';
+
+    /**
+     * @throws RuntimeException aucun compte connecté
+     */
+    public static function exiger(): User
+    {
+        $compte = Auth::user();
+
+        return $compte instanceof User ? $compte : throw new RuntimeException(self::REFUS);
+    }
+}
diff --git a/app/Domain/Tenancy/Support/ModeleRelu.php b/app/Domain/Tenancy/Support/ModeleRelu.php
new file mode 100644
index 0000000..05a7377
--- /dev/null
+++ b/app/Domain/Tenancy/Support/ModeleRelu.php
@@ -0,0 +1,33 @@
+<?php
+
+namespace App\Domain\Tenancy\Support;
+
+use Illuminate\Database\Eloquent\Model;
+use UnexpectedValueException;
+
+/**
+ * Un modèle relu en base (fresh()), avec les relations demandées, là où il
+ * existe forcément : l'action qui le relit vient de l'enregistrer, ou le
+ * tient sous son verrou. Un modèle disparu entre-temps est une erreur du
+ * code, refusée par une exception, au lieu d'un modèle nul ; jamais le
+ * refus d'un geste (une LogicException, que les écrans montrent à la
+ * personne, voir GereLesExceptionsMetier) : comme l'erreur de PHP qu'elle
+ * remplace, elle remonte jusqu'au journal de l'application.
+ */
+final class ModeleRelu
+{
+    public const REFUS = 'Un enregistrement %s n\'existe plus en base : il ne se relit pas.';
+
+    /**
+     * @template TModele of Model
+     *
+     * @param  TModele  $modele
+     * @return TModele
+     *
+     * @throws UnexpectedValueException le modèle n'existe plus
+     */
+    public static function de(Model $modele, string ...$relations): Model
+    {
+        return $modele->fresh($relations) ?? throw new UnexpectedValueException(sprintf(self::REFUS, $modele::class));
+    }
+}
