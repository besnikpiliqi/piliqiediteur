diff --git a/tests/Feature/Facturation/ActionsUniquesCourseConcurrenceTest.php b/tests/Feature/Facturation/ActionsUniquesCourseConcurrenceTest.php
new file mode 100644
index 0000000..1fbcf08
--- /dev/null
