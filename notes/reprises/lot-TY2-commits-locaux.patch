+        foreach (ValeursLues::entiers($societes) as $societeId) {
+            try {
+                $closes += $clore->cloreSansCode(Societe::query()->findOrFail($societeId), $limite) ? 1 : 0;
+            } catch (Throwable $erreur) {
+                report($erreur);
+                $enEchec++;
+            }
+        }
 
         $this->info("{$closes} inscription(s) close(s).");
 
