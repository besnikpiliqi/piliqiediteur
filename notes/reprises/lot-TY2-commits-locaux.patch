+ */
+function contenuDe(string $fichier): string
+{
+    $contenu = file_get_contents($fichier);
+
+    if ($contenu === false) {
+        throw new RuntimeException("Fichier illisible : {$fichier}.");
+    }
+
+    return $contenu;
