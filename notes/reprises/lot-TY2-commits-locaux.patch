 /**
@@ -36,25 +38,26 @@ public function handle(CloreLInscriptionAction $clore): int
         $closes = 0;
         $enEchec = 0;
 
-        Societe::query()
+        $societes = Societe::query()
             ->whereNull('validee_le')
             ->whereNull('close_le')
             ->where('statut', '<>', StatutSociete::Revoquee->value)
             ->where('created_at', '<=', $limite)
