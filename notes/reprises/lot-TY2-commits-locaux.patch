+function tableauLu(mixed $valeur, string $quoi): array
+{
+    if (! is_array($valeur)) {
+        throw new RuntimeException(ucfirst($quoi).' n\'est pas un tableau : '.get_debug_type($valeur).'.');
+    }
+
+    return $valeur;
