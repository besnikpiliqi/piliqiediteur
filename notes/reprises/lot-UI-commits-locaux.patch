@@ -109,6 +109,15 @@ ## Tests, commandes et fonctionnement
 php artisan test --parallel
 ```
 
+Sous Windows, quatre précautions (constat C6 de l'éditeur) :
+
+- prenez Node.js 22 ou 24 (LTS) : avec Node.js 26, `npx playwright install chromium` se fige à « extracting archive ». S'il se fige, décompressez Chromium à la main : téléchargez les archives `chrome-win64.zip` et `chrome-headless-shell-win64.zip` de la version de Chromium qu'attend Playwright 1.59.1 (l'adresse s'affiche quand la commande commence), décompressez-les avec `Expand-Archive` (PowerShell) dans `%LOCALAPPDATA%\ms-playwright\chromium-1217` et `%LOCALAPPDATA%\ms-playwright\chromium_headless_shell-1217`, puis créez dans chacun de ces deux dossiers un fichier vide `INSTALLATION_COMPLETE` ; FFmpeg n'est pas nécessaire aux tests ;
+- avant les tests en navigateur, compilez une fois les vues : `php artisan view:cache`. Sinon, un antivirus qui tient la vue qu'une page vient de compiler fait échouer son renommage (« rename(…): Accès refusé (code: 5) », erreur 500). La suite ne le fait pas d'elle-même : sous `--parallel`, chaque processus recompilerait les mêmes vues en même temps, la course même que l'on évite. Après un `git pull` qui change une vue, relancez-la (ou `php artisan view:clear` pour revenir à la compilation à la demande) ;
+- un PC plus lent que la CI (serveur PHP intégré, antivirus, premières pages froides) peut dépasser le délai de 15 s d'un geste : réglez-le, en secondes, par la variable `PILIQI_NAVIGATEUR_DELAI` avant de lancer les tests, par exemple `$env:PILIQI_NAVIGATEUR_DELAI = "60"` dans PowerShell (`set PILIQI_NAVIGATEUR_DELAI=60` dans une invite de commandes) ; sans elle, le délai reste de 15 s, celui de la CI. Une valeur qui n'est pas un nombre entier de secondes, au moins 1, arrête les tests en le disant ;
+- les fichiers que les tests envoient (pièces du fournisseur, pièces de la vérification) se donnent à Playwright par leur chemin absolu entièrement résolu, avec les séparateurs de Windows : rien à faire de votre côté.
+
+Les tests de concurrence lancent un second processus PHP par `Process` de Laravel (`PHP_BINARY`, sans `pcntl` ni aucune fonction propre à Linux) et lisent l'attente des verrous dans `pg_stat_activity` : rien n'y est propre à Linux, et ils sont écrits pour tourner aussi sous Windows, avec PostgreSQL installé comme au point 3 de l'installation ; ils n'y ont pas encore été lancés (la CI tourne sous Linux) : un échec sous Windows est à signaler.
+
 `package.json` fixe Playwright à la version 1.59.1, celle que demande le module browser de Pest 4 : à partir de Playwright 1.62, le serveur n'applique plus le délai que le module lui envoie, et un clic sur un élément caché attendrait sans fin. Ne la changez pas sans changer le module. Une capture de la page d'un test en échec s'écrit dans `tests/Browser/Screenshots`. Ne lancez pas deux suites en navigateur en même temps dans le même dossier : le module y garde l'adresse de son serveur Playwright (`vendor/pestphp/pest-plugin-browser/.temp`), que la première suite finie efface.
 
 Les balayages (`tests/Browser/Balayage`) ouvrent, rôle par rôle, chaque page de chaque panneau, le profil et les entrées du menu du compte, et chaque action visible, fenêtre ouverte puis fermée sans rien valider ; une action qui ne fait que lire (le PDF d'un document) s'exécute, et le fichier que reçoit le navigateur se vérifie ; une action qui est un lien compte quand le balayage l'a vue et a ouvert sa page. L'inventaire des actions (`tests/Browser/inventaire-des-actions.php`) liste chaque action de l'interface (actions de Filament, avis compris, filtres, onglets, champs, liens, et dans les vues chaque bouton, formulaire, saisie et lien), le lot qui écrit ses tests et les tests qui la couvrent déjà, et `InventaireDesActionsTest` le compare au code ; chaque balayage échoue s'il n'ouvre pas une action que l'inventaire dit couverte par lui.
diff --git a/app/Filament/App/FicheDUnDocument.php b/app/Filament/App/FicheDUnDocument.php
new file mode 100644
index 0000000..847e94b
--- /dev/null
+++ b/app/Filament/App/FicheDUnDocument.php
@@ -0,0 +1,87 @@
+<?php
+
+namespace App\Filament\App;
+
+use App\Domain\Achats\Models\AvoirFournisseur;
+use App\Domain\Achats\Models\FactureAchat;
+use App\Domain\Facturation\Enums\TypeDocument;
+use App\Domain\Facturation\Models\Avoir;
+use App\Domain\Facturation\Models\ClotureCaisse;
+use App\Domain\Facturation\Models\Devis;
+use App\Domain\Facturation\Models\Facture;
+use App\Filament\App\Resources\AvoirFournisseurResource;
+use App\Filament\App\Resources\AvoirResource;
+use App\Filament\App\Resources\ClotureCaisseResource;
+use App\Filament\App\Resources\DevisResource;
+use App\Filament\App\Resources\FactureAchatResource;
+use App\Filament\App\Resources\FactureResource;
+use Illuminate\Contracts\Support\Htmlable;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Support\HtmlString;
+
+/**
+ * La fiche d'un document du magasin actif, vers laquelle mène son numéro
+ * (constat C2 de l'éditeur, confirmé à T43 : « tout numéro de document
+ * affiché devient un lien vers ce document pour qui peut le voir ») : le
+ * numéro d'un ticket, d'une facture, d'un avoir, d'un devis, d'une
+ * facture d'achat, d'un avoir fournisseur ou d'une clôture du jour mène à
+ * sa fiche quand la personne connectée peut la voir (la ressource lui est
+ * ouverte et la règle de ce document, voir les policies, le lui permet :
+ * ses ventes seulement, ou celles de toute l'équipe) ; sinon il reste un
+ * texte simple, sans lien qui mènerait à un refus. Un document d'un autre
+ * magasin n'a jamais de lien (voir les policies : appartientAuMagasinActif).
+ */
+final class FicheDUnDocument
+{
+    /**
+     * La ressource de chaque sorte de document.
+     *
+     * @var array<class-string<Model>, class-string<\Filament\Resources\Resource>>
+     */
+    private const RESSOURCES = [
+        Facture::class => FactureResource::class,
+        Avoir::class => AvoirResource::class,
+        Devis::class => DevisResource::class,
+        FactureAchat::class => FactureAchatResource::class,
+        AvoirFournisseur::class => AvoirFournisseurResource::class,
+        ClotureCaisse::class => ClotureCaisseResource::class,
+    ];
+
+    /**
+     * L'adresse de la fiche de ce document pour la personne connectée ;
+     * null si elle ne peut pas la voir, ou sans document.
+     */
+    public static function adresse(?Model $document): ?string
+    {
+        $ressource = $document === null ? null : (self::RESSOURCES[$document::class] ?? null);
+
+        if ($ressource === null || ! $ressource::canAccess() || ! $ressource::canView($document)) {
+            return null;
+        }
+
+        return $ressource::getUrl('view', ['record' => $document]);
+    }
+
+    /**
+     * Ce que ce document de vente est : « Ticket » ou « Facture », selon
+     * sa série.
+     */
+    public static function nature(Facture $document): string
+    {
+        return $document->serie() === TypeDocument::TicketCaisse ? 'Ticket' : 'Facture';
+    }
+
+    /**
+     * Le numéro de ce document, en lien vers sa fiche pour qui peut la voir,
+     * en texte simple pour les autres, échappé dans les deux cas : pour une
+     * liste de numéros dans une seule entrée ou une seule colonne.
+     */
+    public static function numeroEnLien(Model $document, string $numero): Htmlable
+    {
+        $adresse = self::adresse($document);
+
+        return new HtmlString($adresse === null
+            ? e($numero)
+            : '<a href="'.e($adresse).'" class="text-primary-600 underline dark:text-primary-400">'.e($numero).'</a>');
+    }
+}
